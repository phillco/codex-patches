+use super::*;
+use pretty_assertions::assert_eq;
+use std::fs;
+
+#[test]
+fn knowledge_survives_reload_and_merges_independent_writers() -> std::io::Result<()> {
+    let home = tempfile::tempdir()?;
+    assert_eq!(load_known(home.path())?, Vec::<String>::new());
+    remember(home.path(), "payment retries")?;
+    let first_client = load_known(home.path())?;
+    let second_client = load_known(home.path())?;
+    assert_eq!(first_client, second_client);
+    remember(home.path(), "database isolation")?;
+    // A client with an older view must merge the file instead of writing its cached topics.
+    remember(home.path(), "PAYMENT RETRIES")?;
+    assert_eq!(
+        load_known(home.path())?,
+        vec!["database isolation", "PAYMENT RETRIES"]
+    );
+    Ok(())
+}
+
+#[test]
+fn knowledge_retains_the_latest_bounded_topics() -> std::io::Result<()> {
+    let home = tempfile::tempdir()?;
+    for index in 0..68 {
+        remember(home.path(), &format!("topic {index}"))?;
+    }
+    assert_eq!(
+        load_known(home.path())?,
+        (4..68)
+            .map(|index| format!("topic {index}"))
+            .collect::<Vec<_>>()
+    );
+    Ok(())
+}
+
+#[test]
+fn invalid_knowledge_is_reported_without_overwriting_it() -> std::io::Result<()> {
+    let home = tempfile::tempdir()?;
+    let path = home.path().join("heads-up-known.json");
+    let invalid_documents = [
+        "x".repeat(32_769),
+        serde_json::to_string(&vec!["topic"; 65])?,
+        serde_json::to_string(&vec!["界".repeat(65)])?,
+        serde_json::to_string(&vec!["topic\u{202e}"])?,
+        serde_json::to_string(&vec!["topic\n"])?,
+        "{broken".to_string(),
+    ];
+    for document in invalid_documents {
+        fs::write(&path, &document)?;
+        assert!(load_known(home.path()).is_err());
+        assert!(remember(home.path(), "new topic").is_err());
+        assert_eq!(fs::read_to_string(&path)?, document);
+    }
+    Ok(())
+}
+
+#[test]
+fn full_unicode_topics_fit_and_invalid_new_topics_do_not_change_storage() -> std::io::Result<()> {
+    let home = tempfile::tempdir()?;
+    let topics = (0..64)
+        .map(|index| {
+            format!(
+                "{}{}",
+                char::from_u32(0x1f300 + index).unwrap(),
+                "🦀".repeat(63)
+            )
+        })
+        .collect::<Vec<_>>();
+    for topic in &topics {
+        remember(home.path(), topic)?;
+    }
+    assert_eq!(load_known(home.path())?, topics);
+    for invalid in [
+        "".to_string(),
+        " ".to_string(),
+        "x".repeat(65),
+        "topic\u{2066}".to_string(),
+        "topic\0".to_string(),
+    ] {
+        assert!(remember(home.path(), &invalid).is_err());
+    }
+    assert_eq!(load_known(home.path())?, topics);
+    Ok(())
+}
+
+#[test]
+fn seen_topics_survive_reopen_and_stay_scoped_to_the_thread() -> std::io::Result<()> {
+    let home = tempfile::tempdir()?;
+    let first = ThreadId::new();
+    let second = ThreadId::new();
+    assert_eq!(load_seen(home.path(), first)?, Vec::<String>::new());
+    remember_seen(home.path(), first, "payment retries")?;
+    remember_seen(home.path(), second, "database isolation")?;
+    remember(home.path(), "global knowledge")?;
+    assert_eq!(load_seen(home.path(), first)?, vec!["payment retries"]);
+    assert_eq!(load_seen(home.path(), second)?, vec!["database isolation"]);
+    assert_eq!(load_known(home.path())?, vec!["global knowledge"]);
+    let path = home.path().join("heads-up").join(format!("{first}.json"));
+    fs::write(&path, "{broken")?;
+    assert!(remember_seen(home.path(), first, "new topic").is_err());
+    assert_eq!(fs::read_to_string(path)?, "{broken");
+    assert_eq!(load_seen(home.path(), second)?, vec!["database isolation"]);
+    Ok(())
+}
+
+#[test]
+fn concurrent_writer_lock_leaves_knowledge_unchanged() -> std::io::Result<()> {
+    let home = tempfile::tempdir()?;
+    remember(home.path(), "existing topic")?;
+    let lock = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(home.path().join("heads-up-known.lock"))?;
+    lock.try_lock().map_err(std::io::Error::other)?;
+    assert!(remember(home.path(), "new topic").is_err());
+    assert_eq!(load_known(home.path())?, vec!["existing topic"]);
+    drop(lock);
+    remember(home.path(), "new topic")?;
+    assert_eq!(
+        load_known(home.path())?,
+        vec!["existing topic", "new topic"]
+    );
+    Ok(())
+}
+
+#[test]
+fn requests_are_disabled_by_default_and_do_not_overlap() {
+    let mut state = HeadsUpState::default();
+    assert_eq!(state.begin_request(), None);
+    state.enabled = true;
+    state.steps = 6;
+    state.completion_pending = true;
+    let generation = state.begin_request().unwrap();
+    assert_eq!(state.begin_request(), None);
+    assert_eq!(
+        (state.pending, state.steps, state.completion_pending),
+        (Some((generation, 0)), 0, false)
+    );
+    assert!(state.accept_result(generation));
+    state.note = Some(HeadsUpNote {
+        thread_id: ThreadId::new(),
+        generation,
+        finding: ThreadHeadsUpFinding {
+            topic: "payment retries".to_string(),
+            summary: "Retries can double-charge customers.".to_string(),
+            explanation: "Keep the idempotency key stable across retries.".to_string(),
+        },
+        expanded: false,
+    });
+    assert_eq!(state.begin_request(), None);
+    state.note = None;
+    let next = state.begin_request().unwrap();
+    assert_ne!(next, generation);
+}
+
+#[test]
+fn incorrect_generation_cannot_consume_the_current_request() {
+    let mut state = HeadsUpState {
+        enabled: true,
+        ..Default::default()
+    };
+    let generation = state.begin_request().unwrap();
+    assert!(!state.accept_result(generation + 1));
+    assert_eq!(state.pending, Some((generation, 0)));
+    assert!(state.accept_result(generation));
+    assert_eq!(state.pending, None);
+    assert!(!state.accept_result(generation));
+}
+
+#[test]
+fn epoch_changes_and_disabled_state_reject_in_flight_results() {
+    let mut state = HeadsUpState {
+        enabled: true,
+        ..Default::default()
+    };
+    let generation = state.begin_request().unwrap();
+    state.epoch += 1;
+    assert!(!state.accept_result(generation));
+    assert_eq!(state.pending, None);
+    let generation = state.begin_request().unwrap();
+    state.enabled = false;
+    assert!(!state.accept_result(generation));
+    assert_eq!(state.pending, None);
+    assert_eq!(state.begin_request(), None);
+    state.enabled = true;
+    let generation = state.begin_request().unwrap();
+    assert!(state.accept_result(generation));
+}
