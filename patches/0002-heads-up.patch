@@ -0,0 +1,25 @@
+//! Preserve the draft and attachments when inserting a Heads Up discussion.
+
+use super::ChatComposer;
+use super::sanitize_user_text;
+
+impl ChatComposer {
+    pub(crate) fn append_draft_text(&mut self, text: &str) -> Result<(), &'static str> {
+        if !self.draft.input_enabled {
+            return Err("Composer input is disabled");
+        }
+        if self.history_search.is_some() || self.draft.textarea.is_vim_operator_pending() {
+            return Err("Composer search or Vim command is active");
+        }
+        if let Some(pasted) = self.draft.paste_burst.flush_before_modified_input() {
+            self.handle_paste(pasted);
+        }
+        self.draft.paste_burst.clear_after_explicit_paste();
+        let text = text.replace("\r\n", "\n").replace('\r', "\n");
+        let text = sanitize_user_text(text.into());
+        self.attachments.clear_remote_image_selection();
+        self.move_cursor_to_end();
+        self.insert_str(&text);
+        Ok(())
+    }
+}
