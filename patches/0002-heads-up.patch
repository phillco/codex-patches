+        "The old database is our only backup.",
+        "The backup copy failed.",
+    ] {
+        test.codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: text.into(),
+                text_elements: vec![],
+            }]))
