new file mode 100644
index 00000000000000000000..9c6b7cfc0b1bc659e461
--- /dev/null
+++ b/codex-rs/core/src/heads_up.rs
@@ -0,0 +1,307 @@
+//! Independent, tool-less review of a retained conversation without mutating it.
+use crate::client_common::Prompt;
+use crate::client_common::ResponseEvent;
+use crate::client_common::ToolChoice;
+use crate::codex_thread::CodexThread;
+use crate::context::ContextualUserFragment;
+use crate::context::HeadsUpReview;
+use crate::responses_metadata::CodexResponsesMetadata;
+use crate::session::step_settings::ResolvedStepSettings;
+use codex_otel::SessionTelemetry;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::CodexErrorDetails;
+use codex_protocol::error::Result;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_rollout_trace::InferenceTraceContext;
+use futures::StreamExt;
+use serde::Deserialize;
+use std::future::Future;
+use std::sync::Arc;
+use std::time::Duration;
+
+/// One bounded implication worth surfacing to the user.
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct HeadsUpFinding {
+    pub topic: String,
+    pub summary: String,
+    pub explanation: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ReviewOutput {
+    #[serde(deserialize_with = "Option::deserialize")]
+    finding: Option<HeadsUpFinding>,
+}
+
+/// Exactly one parent sampling request and its resolved settings, replaced every step.
+#[derive(Clone)]
+pub(crate) struct HeadsUpPrompt {
+    pub(crate) prompt: Prompt,
+    pub(crate) settings: Arc<ResolvedStepSettings>,
+    pub(crate) effort: Option<ReasoningEffort>,
+    pub(crate) telemetry: SessionTelemetry,
+    pub(crate) metadata: CodexResponsesMetadata,
+}
+
+/// Capture and review lifetime share one lock so disabling cannot race a sampling update.
+pub(crate) struct HeadsUpState {
+    pub(crate) enabled: bool,
+    pub(crate) prompt: Option<HeadsUpPrompt>,
+    cancellation: tokio_util::sync::CancellationToken,
+}
+
+impl HeadsUpState {
+    pub(crate) fn new(enabled: bool) -> Self {
+        Self {
+            enabled,
+            prompt: None,
+            cancellation: tokio_util::sync::CancellationToken::new(),
+        }
+    }
+}
+
+impl CodexThread {
+    /// Changes capture without changing the conversation; disabling also cancels active reviews.
+    pub async fn set_heads_up_enabled(&self, enabled: bool) {
+        let mut state = self.session.heads_up.lock().await;
+        if state.enabled != enabled {
+            state.cancellation.cancel();
+            state.cancellation = tokio_util::sync::CancellationToken::new();
+        }
+        state.enabled = enabled;
+        if !enabled {
+            state.prompt = None;
+        }
+    }
+
+    /// Reviews retained context using this thread's model and authentication, without tool execution or history writes.
+    pub async fn review_heads_up(&self, known: Vec<String>) -> Result<Option<HeadsUpFinding>> {
+        if known.len() > 64 || known.iter().any(|topic| topic.chars().count() > 64) {
+            return Err(CodexErr::InvalidRequest(
+                "Heads Up known topics exceed their limits".into(),
+            ));
+        }
+        let cancellation = {
+            let state = self.session.heads_up.lock().await;
+            if !state.enabled {
+                return Ok(None);
+            }
+            state.cancellation.clone()
+        };
+        let review = review_with_retries(|| async {
+            let (snapshot, history) = loop {
+                let Some(snapshot) = self.session.heads_up.lock().await.prompt.clone() else {
+                    // A resumed thread must first sample locally so we know its settings.
+                    return Ok(None);
+                };
+                // A custom output format cannot express our reviewer result without changing
+                // the parent's cached prefix. Stay quiet rather than silently invalidating it.
+                if snapshot.prompt.output_schema.is_some() {
+                    return Ok(None);
+                }
+                let history = self.session.clone_history().await;
+                if history.reference_context_item().is_some() {
+                    break (snapshot, history);
+                }
+                // Manual compaction can remove initial instructions before the next parent
+                // step restores them. Wait within the same deadline for a complete baseline,
+                // without running context-building tools or reporting an unreviewed result.
+                tokio::time::sleep(Duration::from_millis(/*millis*/ 250)).await;
+            };
+            // Refresh the sampled baseline on every attempt, including work completed
+            // since the previous request and any intervening compaction.
+            let (mut prompt, settings, effort, telemetry, metadata) = {
+                let retained = history.for_prompt(&snapshot.settings.model_info.input_modalities);
+                let prefix_len = snapshot.prompt.input.len();
+                let mut prompt = snapshot.prompt.clone();
+                if retained.len() >= prefix_len
+                    && retained[..prefix_len]
+                        .iter()
+                        .zip(&snapshot.prompt.input)
+                        .all(|(current, previous)| {
+                            let mut current = current.clone();
+                            let mut previous = previous.clone();
+                            current.clear_tool_result_metadata();
+                            previous.clear_tool_result_metadata();
+                            current == previous
+                        })
+                {
+                    // Preserve the sampled input and its executed-tool annotations when
+                    // it remains a prefix of the current retained conversation.
+                    prompt.input.extend_from_slice(&retained[prefix_len..]);
+                } else {
+                    // Compaction or replacement can precede the next parent sample.
+                    // Review its latest retained baseline now, without restoring obsolete
+                    // content or changing the parent's stored prompt and history.
+                    prompt.input = retained;
+                }
+                (
+                    prompt,
+                    &snapshot.settings,
+                    snapshot.effort.clone(),
+                    &snapshot.telemetry,
+                    &snapshot.metadata,
+                )
+            };
+            prompt.tool_choice = ToolChoice::None;
+            prompt.input.push(
+                HeadsUpReview {
+                    known: known.iter().rev().take(/*n*/ 8).cloned().collect(),
+                }
+                .render_fragment()
+                .into(),
+            );
+            let mut client = self.session.services.model_client.new_session();
+            let mut stream = client
+                .stream(
+                    &prompt,
+                    &settings.model_info,
+                    telemetry,
+                    effort,
+                    settings.reasoning_summary,
+                    settings.service_tier.clone(),
+                    metadata,
+                    &InferenceTraceContext::disabled(),
+                )
+                .await?;
+            let mut output = String::new();
+            let mut completed = false;
+            while let Some(event) = stream.next().await {
+                match event? {
+                    ResponseEvent::OutputItemDone(ResponseItem::Message {
+                        role, content, ..
+                    }) if role == "assistant" => {
+                        for item in content {
+                            if let ContentItem::OutputText { text } = item {
+                                // Bound collection even when the provider ignores its schema.
+                                if output.len().saturating_add(text.len()) > 24_000 {
+                                    return Err(CodexErr::InvalidRequest(
+                                        "Heads Up output exceeds its limit".into(),
+                                    ));
+                                }
+                                output.push_str(&text);
+                            }
+                        }
+                    }
+                    ResponseEvent::OutputItemDone(ResponseItem::Reasoning { .. }) => {}
+                    ResponseEvent::OutputItemDone(_) => {
+                        return Err(CodexErr::InvalidRequest(
+                            "Heads Up returned an unexpected item".into(),
+                        ));
+                    }
+                    ResponseEvent::Completed { token_usage, .. } => {
+                        if let Some(usage) = token_usage {
+                            tracing::debug!(
+                                input_tokens = usage.input_tokens,
+                                cached_input_tokens = usage.cached_input_tokens,
+                                cache_write_input_tokens = usage.cache_write_input_tokens,
+                                "Heads Up cache usage"
+                            );
+                        }
+                        completed = true;
+                        break;
+                    }
+                    _ => {}
+                }
+            }
+            if !completed {
+                return Err(CodexErr::Stream(
+                    "Heads Up stream ended before completion".into(),
+                ));
+            }
+            parse_finding(&output, &known)
+        });
+        tokio::select! {
+            biased;
+            _ = cancellation.cancelled() => Ok(None),
+            result = review => result,
+        }
+    }
+}
+
+/// Retry transient inference failures; each attempt can extend the retained conversation prefix.
+async fn review_with_retries<F, Fut>(mut request: F) -> Result<Option<HeadsUpFinding>>
+where
+    F: FnMut() -> Fut,
+    Fut: Future<Output = Result<Option<HeadsUpFinding>>>,
+{
+    // Keep a hard total bound even when the server requests a long retry delay.
+    tokio::time::timeout(Duration::from_secs(/*secs*/ 420), async {
+        let mut attempt = 0;
+        loop {
+            attempt += 1;
+            let result = tokio::time::timeout(Duration::from_secs(/*secs*/ 120), request())
+                .await
+                .unwrap_or_else(|_| Err(CodexErr::RequestTimeout));
+            let error = match result {
+                Ok(finding) => return Ok(finding),
+                Err(error) => error,
+            };
+            let retryable = (error.is_retryable()
+                && !matches!(error.details(), CodexErrorDetails::Json(_)))
+                || matches!(error.details(), CodexErrorDetails::ServerOverloaded)
+                || matches!(error.details(), CodexErrorDetails::RetryLimit(error)
+                    if error.status.is_server_error() || error.status.as_u16() == 429);
+            if attempt == 3 || !retryable {
+                return Err(error);
+            }
+            let delay = error
+                .retry_delay()
+                .unwrap_or_else(|| Duration::from_secs(/*secs*/ 2_u64.pow(attempt)));
+            tracing::debug!(attempt, %error, ?delay, "Retrying Heads Up review");
+            tokio::time::sleep(delay).await;
+        }
+    })
+    .await
+    .map_err(|_| CodexErr::RequestTimeout)?
+}
+
+fn parse_finding(output: &str, known: &[String]) -> Result<Option<HeadsUpFinding>> {
+    let Some(mut finding) = serde_json::from_str::<ReviewOutput>(output)?.finding else {
+        return Ok(None);
+    };
+    finding.topic = finding.topic.trim().to_string();
+    finding.summary = finding.summary.trim().to_string();
+    finding.explanation = finding.explanation.trim().to_string();
+    let unsafe_text = [&finding.topic, &finding.summary].into_iter().any(|text| {
+        text.chars().any(|ch| {
+            ch.is_control() || matches!(
+                ch,
+                '\u{061c}' | '\u{200e}' | '\u{200f}' | '\u{202a}'..='\u{202e}' | '\u{2066}'..='\u{2069}'
+            )
+        })
+    }) || finding.explanation.chars().any(|ch| {
+        (ch.is_control() && ch != '\n' && ch != '\t')
+            || matches!(
+                ch,
+                '\u{061c}' | '\u{200e}' | '\u{200f}' | '\u{202a}'..='\u{202e}' | '\u{2066}'..='\u{2069}'
+            )
+    });
+    if unsafe_text
+        || finding.topic.is_empty()
+        || finding.summary.is_empty()
+        || finding.explanation.is_empty()
+        || finding.topic.chars().count() > 64
+        || finding.summary.chars().count() > 360
+        || finding.explanation.chars().count() > 3000
+    {
+        return Err(CodexErr::InvalidRequest(
+            "Heads Up finding exceeds its limits".into(),
+        ));
+    }
+    if known
+        .iter()
+        .any(|topic| topic.trim().to_lowercase() == finding.topic.to_lowercase())
+    {
+        return Ok(None);
+    }
+    Ok(Some(finding))
+}
+
