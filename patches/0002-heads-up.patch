@@ -0,0 +1,504 @@
+use super::*;
+use crate::heads_up::HeadsUpAction;
+use codex_app_server_protocol::ThreadHeadsUpFinding;
+use pretty_assertions::assert_eq;
+
+fn next_review(
+    rx: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) -> Option<(ThreadId, u64, Vec<String>)> {
+    while let Ok(event) = rx.try_recv() {
+        if let AppEvent::RequestHeadsUp {
+            thread_id,
+            generation,
+            known,
+        } = event
+        {
+            return Some((thread_id, generation, known));
+        }
+    }
+    None
+}
+
+fn finding() -> ThreadHeadsUpFinding {
+    ThreadHeadsUpFinding {
+        topic: "Backups".into(),
+        summary: "Keep the backup".into(),
+        explanation: "It is the only rollback copy.".into(),
+    }
+}
+
+#[tokio::test]
+async fn heads_up_reviews_during_work_and_coalesces_final_snapshot() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.heads_up.enabled = true;
+    chat.heads_up_turn_started();
+    for _ in 0..5 {
+        chat.heads_up_step_completed();
+    }
+    assert!(next_review(&mut rx).is_none());
+    chat.heads_up_step_completed();
+    let (thread_id, generation, known) = next_review(&mut rx).expect("six steps request");
+    assert_eq!(known, Vec::<String>::new());
+    for _ in 0..6 {
+        chat.heads_up_step_completed();
+    }
+    chat.heads_up_turn_completed();
+    assert!(next_review(&mut rx).is_none(), "one in-flight reviewer");
+    chat.on_heads_up_result(thread_id, generation, Ok(None));
+    let (_, final_generation, _) =
+        next_review(&mut rx).expect("final snapshot after pending review");
+    assert_ne!(final_generation, generation);
+    chat.on_heads_up_result(thread_id, final_generation, Ok(None));
+    assert!(next_review(&mut rx).is_none(), "quiet review does not loop");
+    assert!(chat.heads_up.note.is_none());
+}
+
+#[tokio::test]
+async fn heads_up_short_turn_reviews_but_disabled_turn_does_not() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.heads_up_step_completed();
+    chat.heads_up_turn_completed();
+    assert!(next_review(&mut rx).is_none());
+    chat.heads_up.enabled = true;
+    chat.heads_up_turn_started();
+    chat.heads_up_step_completed();
+    chat.heads_up_turn_completed();
+    assert!(next_review(&mut rx).is_some());
+}
+
+#[tokio::test]
+async fn heads_up_note_survives_prompt_submission_and_next_turn() {
+    for expanded in [false, true] {
+        let (mut chat, mut rx, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+        let thread_id = ThreadId::new();
+        chat.thread_id = Some(thread_id);
+        chat.heads_up.enabled = true;
+        chat.config.tui_heads_up_expanded = expanded;
+        chat.heads_up_turn_completed();
+        let (_, generation, _) = next_review(&mut rx).unwrap();
+        chat.on_heads_up_result(thread_id, generation, Ok(Some(finding())));
+        assert_eq!(chat.heads_up.note.as_ref().unwrap().expanded, expanded);
+
+        chat.bottom_pane
+            .set_composer_text("Please continue".into(), Vec::new(), Vec::new());
+        chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+        assert_matches!(next_submit_op(&mut ops), Op::UserTurn { .. });
+        handle_turn_started(&mut chat, "next-turn");
+        assert_eq!(
+            chat.heads_up.note.as_ref().map(|note| note.finding.clone()),
+            Some(finding())
+        );
+        assert_eq!(chat.heads_up.note.as_ref().unwrap().expanded, expanded);
+        assert_chatwidget_snapshot!(
+            if expanded {
+                "heads_up_expanded_after_prompt"
+            } else {
+                "heads_up_compact_after_prompt"
+            },
+            render_bottom_popup(&chat, /*width*/ 80)
+        );
+        handle_turn_completed(&mut chat, "next-turn", /*duration_ms*/ None);
+        assert!(next_review(&mut rx).is_none());
+
+        chat.heads_up_action(thread_id, generation, HeadsUpAction::Dismiss);
+        assert!(chat.heads_up.note.is_none());
+        assert!(!render_bottom_popup(&chat, /*width*/ 80).contains("Keep the backup"));
+    }
+}
+
+#[tokio::test]
+async fn heads_up_pending_result_survives_a_new_prompt_and_more_work() {
+    let (mut chat, mut rx, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    chat.heads_up.enabled = true;
+    chat.heads_up_turn_completed();
+    let (_, generation, _) = next_review(&mut rx).unwrap();
+
+    chat.submit_user_message("Please continue".into());
+    assert_matches!(next_submit_op(&mut ops), Op::UserTurn { .. });
+    handle_turn_started(&mut chat, "next-turn");
+    for _ in 0..6 {
