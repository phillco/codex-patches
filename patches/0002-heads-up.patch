+            // A non-OpenAI provider selects local compaction with a readable summary.
+            config.model_provider.name = "Heads Up test".into();
+            config.developer_instructions = Some("Preserve the remaining database backup.".into());
+            config.model_provider.request_max_retries = Some(0);
+            config.model_provider.stream_max_retries = Some(0);
+        })
+        .build_with_auto_env(&server)
