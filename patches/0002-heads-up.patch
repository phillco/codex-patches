+async fn heads_up_retry_retains_old_context_and_includes_new_parent_content() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let parent = responses::mount_sse_once(
+        &server,
+        responses::sse(vec![
+            responses::ev_assistant_message("parent", "I will delete the old database."),
