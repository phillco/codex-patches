+#[tokio::test]
+async fn heads_up_retry_times_out_if_compacted_context_is_never_restored() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let initial = responses::mount_sse_sequence(
+        &server,
+        vec![
+            responses::sse(vec![
+                responses::ev_assistant_message("parent-1", "I will delete the old database."),
+                responses::ev_completed("parent-1"),
+            ]),
+            responses::sse(vec![
+                responses::ev_assistant_message("parent-2", "Deletion remains scheduled."),
+                responses::ev_completed("parent-2"),
+            ]),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
+            config
+                .features
+                .enable(codex_features::Feature::HeadsUp)
+                .expect("enable Heads Up");
+            config.model_provider.name = "Heads Up test".into();
+            config.developer_instructions = Some("Preserve the remaining database backup.".into());
+            config.model_provider.request_max_retries = Some(0);
+            config.model_provider.stream_max_retries = Some(0);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    for text in [
+        "The old database is our only backup.",
+        "The backup copy failed.",
+    ] {
+        test.codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: text.into(),
+                text_elements: vec![],
+            }]))
+            .await?;
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        })
+        .await;
+    }
+    assert_eq!(initial.requests().len(), 2);
+    let reviews = responses::mount_sse_sequence(
+        &server,
+        vec![
+            responses::sse_failed("failed", "rate_limit_exceeded", "Try again in 10s."),
+            responses::sse(vec![
+                responses::ev_assistant_message(
+                    "compaction",
+                    "The old database is the only backup. The attempted backup copy failed.",
+                ),
+                responses::ev_completed("compaction"),
+            ]),
+        ],
+    )
+    .await;
+    let codex = test.codex.clone();
+    let mut reviewer = tokio::spawn(async move { codex.review_heads_up(vec![]).await });
+    tokio::time::timeout(Duration::from_secs(/*secs*/ 5), async {
+        while reviews.requests().is_empty() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await?;
+    test.codex.submit(Op::Compact).await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let after_compaction = test.codex.conversation_history_snapshot().await;
+
+    // Expected HTTP traffic has completed. Only the missing-context wait and its
+    // bounded deadlines remain, so exercise the full wait without real minutes.
+    tokio::time::pause();
+    tokio::time::advance(Duration::from_secs(/*secs*/ 12)).await;
+    let still_pending = tokio::time::timeout(Duration::from_millis(/*millis*/ 1), &mut reviewer)
+        .await
+        .is_err();
+    assert!(
+        still_pending,
+        "unreviewed compacted context must not return Ok(None)"
+    );
+    assert_eq!(reviews.requests().len(), 2);
+    tokio::time::advance(Duration::from_secs(/*secs*/ 420)).await;
+    let result = tokio::time::timeout(Duration::from_secs(/*secs*/ 1), &mut reviewer).await;
+    tokio::time::resume();
+
+    assert!(matches!(
+        result??.unwrap_err().details(),
+        CodexErrorDetails::RequestTimeout
+    ));
+    assert_eq!(reviews.requests().len(), 2);
+    assert_eq!(
+        server
+            .received_requests()
+            .await
+            .unwrap()
+            .iter()
+            .filter(|request| request.url.path().ends_with("/responses"))
+            .count(),
+        4
+    );
+    assert_eq!(
+        after_compaction.items().collect::<Vec<_>>(),
+        test.codex
+            .conversation_history_snapshot()
+            .await
+            .items()
+            .collect::<Vec<_>>()
+    );
+    Ok(())
+}
