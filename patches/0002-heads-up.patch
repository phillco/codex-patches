+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn heads_up_disable_cancels_review_drops_capture_and_requires_fresh_sampling() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let test = test_codex()
+        .with_config(|config| {
+            config
+                .features
+                .enable(codex_features::Feature::HeadsUp)
+                .expect("enable Heads Up");
+            config.model_provider.request_max_retries = Some(0);
+            config.model_provider.stream_max_retries = Some(0);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    let parent = responses::mount_sse_once(
+        &server,
+        responses::sse(vec![
+            responses::ev_assistant_message("parent", "Recorded."),
+            responses::ev_completed("parent"),
+        ]),
+    )
+    .await;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Keep my backup.".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let _ = parent.single_request();
+    let before = test.codex.conversation_history_snapshot().await;
+    let review = responses::mount_sse_once(
+        &server,
+        responses::sse_failed("failed", "rate_limit_exceeded", "Try again in 60s."),
+    )
+    .await;
+    let disable = async {
+        while review.requests().is_empty() {
+            tokio::task::yield_now().await;
+        }
+        test.codex.set_heads_up_enabled(/*enabled*/ false).await;
+    };
+    let (finding, ()) = tokio::time::timeout(Duration::from_secs(/*secs*/ 5), async {
+        tokio::join!(test.codex.review_heads_up(vec![]), disable)
+    })
+    .await?;
+    assert_eq!(finding?, None);
+    assert_eq!(
+        before.items().collect::<Vec<_>>(),
+        test.codex
+            .conversation_history_snapshot()
+            .await
+            .items()
+            .collect::<Vec<_>>()
+    );
+
+    // A queued review cannot turn capture back on. Enabling before another sample must
+    // remain quiet too: disabling released the old snapshot, not just the visible note.
+    assert_eq!(test.codex.review_heads_up(vec![]).await?, None);
+    test.codex.set_heads_up_enabled(/*enabled*/ true).await;
+    assert_eq!(test.codex.review_heads_up(vec![]).await?, None);
+    assert_eq!(review.requests().len(), 1);
+    test.codex.set_heads_up_enabled(/*enabled*/ false).await;
+
+    for enabled in [false, true] {
+        test.codex.set_heads_up_enabled(enabled).await;
+        let parent = responses::mount_sse_once(
+            &server,
+            responses::sse(vec![
+                responses::ev_assistant_message("next-parent", "Recorded again."),
+                responses::ev_completed("next-parent"),
+            ]),
+        )
+        .await;
+        test.codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "The backup is still needed.".into(),
+                text_elements: vec![],
+            }]))
+            .await?;
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        })
+        .await;
+        let _ = parent.single_request();
+        if !enabled {
+            // Even sampling while disabled must not leave a snapshot for later enable.
+            test.codex.set_heads_up_enabled(/*enabled*/ true).await;
+            assert_eq!(test.codex.review_heads_up(vec![]).await?, None);
+        }
+    }
+    let review = responses::mount_sse_once(
+        &server,
+        responses::sse(vec![
+            responses::ev_assistant_message("review", "{\"finding\":null}"),
+            responses::ev_completed("review"),
+        ]),
+    )
+    .await;
+    assert_eq!(test.codex.review_heads_up(vec![]).await?, None);
+    assert_eq!(review.single_request().body_json()["tool_choice"], "none");
+    Ok(())
+}
