+        chat.heads_up_step_completed();
+        chat.on_heads_up_result(thread_id, generation, stale_result);
+
+        assert!(chat.heads_up.note.is_none());
+        let mut refreshed_generation = None;
+        while let Ok(event) = rx.try_recv() {
+            assert!(!matches!(&event, AppEvent::InsertHistoryCell(_)));
+            if let AppEvent::RequestHeadsUp { generation, .. } = event {
+                refreshed_generation = Some(generation);
+            }
+        }
+        let refreshed_generation = refreshed_generation.expect("expanded context review");
+        assert_ne!(generation, refreshed_generation);
+        // Continued work during the fresh pass must not trigger an endless refresh chain.
+        chat.heads_up_step_completed();
+        chat.on_heads_up_result(thread_id, refreshed_generation, Ok(Some(finding())));
+        assert_eq!(
+            chat.heads_up.note.as_ref().map(|note| note.finding.clone()),
+            Some(finding())
+        );
+        assert!(next_review(&mut rx).is_none());
