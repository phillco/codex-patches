@@ -0,0 +1,46 @@
+use super::*;
+use codex_app_server_protocol::ThreadHeadsUpFinding;
+use codex_app_server_protocol::ThreadHeadsUpParams;
+use codex_app_server_protocol::ThreadHeadsUpResponse;
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn thread_heads_up_set_enabled(
+        &self,
+        params: codex_app_server_protocol::ThreadHeadsUpSetEnabledParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let thread_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|err| invalid_request(format!("invalid thread id: {err}")))?;
+        let thread = self
+            .thread_manager
+            .get_thread(thread_id)
+            .await
+            .map_err(|err| invalid_request(format!("thread is not loaded: {err}")))?;
+        thread.set_heads_up_enabled(params.enabled).await;
+        Ok(Some(
+            codex_app_server_protocol::ThreadHeadsUpSetEnabledResponse {}.into(),
+        ))
+    }
+
+    pub(crate) async fn thread_heads_up(
+        &self,
+        params: ThreadHeadsUpParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let thread_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|err| invalid_request(format!("invalid thread id: {err}")))?;
+        let thread = self
+            .thread_manager
+            .get_thread(thread_id)
+            .await
+            .map_err(|err| invalid_request(format!("thread is not loaded: {err}")))?;
+        let finding = thread
+            .review_heads_up(params.known.unwrap_or_default())
+            .await
+            .map_err(|err| internal_error(format!("Heads Up review failed: {err}")))?
+            .map(|finding| ThreadHeadsUpFinding {
+                topic: finding.topic,
+                summary: finding.summary,
+                explanation: finding.explanation,
+            });
+        Ok(Some(ThreadHeadsUpResponse { finding }.into()))
+    }
+}
diff --git a/codex-rs/app-server/tests/suite/v2/heads_up.rs b/codex-rs/app-server/tests/suite/v2/heads_up.rs
new file mode 100644
index 00000000000000000000..47bf4011c001d840080e
--- /dev/null
+++ b/codex-rs/app-server/tests/suite/v2/heads_up.rs
@@ -0,0 +1,136 @@
+use anyhow::Result;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use app_test_support::create_mock_responses_server_sequence;
+use codex_app_server_protocol::ThreadHeadsUpFinding;
+use codex_app_server_protocol::ThreadHeadsUpParams;
+use codex_app_server_protocol::ThreadHeadsUpResponse;
+use codex_app_server_protocol::ThreadStartParams;
+use codex_app_server_protocol::ThreadStartResponse;
+use codex_app_server_protocol::TurnStartParams;
+use codex_app_server_protocol::TurnStartResponse;
+use codex_app_server_protocol::UserInput;
+use core_test_support::responses;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tempfile::TempDir;
+
+#[tokio::test]
+async fn heads_up_rpc_returns_finding_and_suppresses_known_topic() -> Result<()> {
+    let finding = ThreadHeadsUpFinding {
+        topic: "Backups".into(),
+        summary: "Keep your backup.".into(),
+        explanation: "The old database is the only backup.".into(),
+    };
+    let output = json!({"finding": finding}).to_string();
+    let server = create_mock_responses_server_sequence(vec![
+        responses::sse(vec![
+            responses::ev_assistant_message("parent", "Recorded."),
+            responses::ev_completed("parent"),
+        ]),
+        responses::sse(vec![
+            responses::ev_assistant_message("first", &output),
+            responses::ev_completed("first"),
+        ]),
+        responses::sse(vec![
+            responses::ev_assistant_message("second", &output),
+            responses::ev_completed("second"),
+        ]),
+    ])
+    .await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri()).write(home.path())?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let request = client
+        .send_thread_start_request_with_auto_env(ThreadStartParams::default())
+        .await?;
+    let ThreadStartResponse { thread, .. } = client.read_response(request).await?;
+    let request = client
+        .send_request(
+            "thread/headsUp/setEnabled",
+            Some(json!({
+                "threadId": thread.id, "enabled": true,
+            })),
+        )
+        .await?;
+    let _: codex_app_server_protocol::ThreadHeadsUpSetEnabledResponse =
+        client.read_response(request).await?;
+    let request = client
+        .send_request(
+            "thread/headsUp",
+            Some(serde_json::to_value(ThreadHeadsUpParams {
+                thread_id: thread.id.clone(),
+                known: None,
+            })?),
+        )
+        .await?;
+    let response: ThreadHeadsUpResponse = client.read_response(request).await?;
+    assert_eq!(response, ThreadHeadsUpResponse { finding: None });
+    let request = client
+        .send_turn_start_request(TurnStartParams {
+            thread_id: thread.id.clone(),
+            input: vec![UserInput::Text {
+                text: "The old database is our only backup. Record my plan to delete it after migration.".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let _: TurnStartResponse = client.read_response(request).await?;
+    client
+        .read_stream_until_notification_message("turn/completed")
+        .await?;
+    let request = client
+        .send_request(
+            "thread/headsUp",
+            Some(serde_json::to_value(ThreadHeadsUpParams {
+                thread_id: thread.id.clone(),
+                known: None,
+            })?),
+        )
+        .await?;
+    let response: ThreadHeadsUpResponse = client.read_response(request).await?;
+    assert_eq!(
+        response,
+        ThreadHeadsUpResponse {
+            finding: Some(finding)
+        }
+    );
+    let request = client
+        .send_request(
+            "thread/headsUp",
+            Some(serde_json::to_value(ThreadHeadsUpParams {
+                thread_id: thread.id.clone(),
+                known: Some(vec!["Backups".into()]),
+            })?),
+        )
+        .await?;
+    let response: ThreadHeadsUpResponse = client.read_response(request).await?;
+    assert_eq!(response, ThreadHeadsUpResponse { finding: None });
+    for enabled in [false, true] {
+        let request = client
+            .send_request(
+                "thread/headsUp/setEnabled",
+                Some(json!({
+                    "threadId": thread.id, "enabled": enabled,
+                })),
+            )
+            .await?;
+        let _: codex_app_server_protocol::ThreadHeadsUpSetEnabledResponse =
+            client.read_response(request).await?;
+        let request = client
+            .send_request(
+                "thread/headsUp",
+                Some(json!({
+                    "threadId": thread.id,
+                })),
+            )
+            .await?;
+        let response: ThreadHeadsUpResponse = client.read_response(request).await?;
+        assert_eq!(response, ThreadHeadsUpResponse { finding: None });
+    }
+    Ok(())
+}
