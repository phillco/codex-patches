@@ -0,0 +1,119 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use std::cell::RefCell;
+use tokio::time::Instant;
+
+#[tokio::test(start_paused = true)]
+async fn slow_review_can_finish_after_the_old_deadline() {
+    let started = Instant::now();
+    let result = review_with_retries(|| async {
+        tokio::time::sleep(Duration::from_secs(/*secs*/ 90)).await;
+        Ok(None)
+    })
+    .await;
+
+    assert_eq!(result.unwrap(), None);
+    assert_eq!(started.elapsed(), Duration::from_secs(/*secs*/ 90));
+}
+
+#[tokio::test(start_paused = true)]
+async fn timed_out_review_retries_after_backoff() {
+    let started = Instant::now();
+    let attempts = RefCell::new(Vec::new());
+    let result = review_with_retries(|| {
+        let mut attempts = attempts.borrow_mut();
+        attempts.push(started.elapsed());
+        let first = attempts.len() == 1;
+        async move {
+            if first {
+                std::future::pending::<()>().await;
+            }
+            Ok(None)
+        }
+    })
+    .await;
+
+    assert_eq!(result.unwrap(), None);
+    assert_eq!(
+        attempts.into_inner(),
+        vec![Duration::ZERO, Duration::from_secs(/*secs*/ 122)]
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn repeated_timeouts_exhaust_three_attempts() {
+    let started = Instant::now();
+    let attempts = RefCell::new(Vec::new());
+    let result = review_with_retries(|| {
+        attempts.borrow_mut().push(started.elapsed());
+        std::future::pending()
+    })
+    .await;
+
+    assert!(matches!(
+        result.unwrap_err().details(),
+        CodexErrorDetails::RequestTimeout
+    ));
+    assert_eq!(
+        (attempts.into_inner(), started.elapsed()),
+        (
+            vec![
+                Duration::ZERO,
+                Duration::from_secs(/*secs*/ 122),
+                Duration::from_secs(/*secs*/ 246),
+            ],
+            Duration::from_secs(/*secs*/ 366),
+        )
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn server_retry_delay_is_respected_within_the_total_deadline() {
+    for delay in [10, 600] {
+        let started = Instant::now();
+        let attempts = RefCell::new(Vec::new());
+        let result = review_with_retries(|| {
+            let mut attempts = attempts.borrow_mut();
+            attempts.push(started.elapsed());
+            std::future::ready(if attempts.len() == 1 {
+                Err(CodexErr::ServerOverloaded
+                    .with_retry_delay(Duration::from_secs(/*secs*/ delay)))
+            } else {
+                Ok(None)
+            })
+        })
+        .await;
+
+        if delay == 10 {
+            assert_eq!(result.unwrap(), None);
+            assert_eq!(
+                attempts.into_inner(),
+                vec![Duration::ZERO, Duration::from_secs(/*secs*/ 10)]
+            );
+        } else {
+            assert!(matches!(
+                result.unwrap_err().details(),
+                CodexErrorDetails::RequestTimeout
+            ));
+            assert_eq!(
+                (attempts.into_inner(), started.elapsed()),
+                (vec![Duration::ZERO], Duration::from_secs(/*secs*/ 420))
+            );
+        }
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn invalid_review_output_is_not_retried() {
+    for output in ["invalid JSON", "{\"unexpected\":true}"] {
+        let attempts = RefCell::new(Vec::new());
+        let result = review_with_retries(|| {
+            attempts.borrow_mut().push(output);
+            std::future::ready(parse_finding(output, &[]))
+        })
+        .await;
+
+        assert!(result.is_err());
+        assert_eq!(attempts.into_inner(), vec![output]);
+    }
+}
