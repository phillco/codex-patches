+    let mut bodies = vec![
+        responses::sse_failed("failed", "rate_limit_exceeded", "Try again in 10s."),
+        responses::sse(vec![
+            responses::ev_assistant_message("compaction", summary),
+            responses::ev_completed("compaction"),
