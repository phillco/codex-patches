+use super::*;
+use crate::app_event_sender::AppEventSender;
+use codex_app_server_protocol::ThreadHeadsUpFinding;
+use codex_protocol::ThreadId;
+use insta::assert_snapshot;
+use pretty_assertions::assert_eq;
+use tokio::sync::mpsc::unbounded_channel;
+
+fn note(expanded: bool) -> HeadsUpNote {
+    HeadsUpNote {
+        thread_id: ThreadId::new(),
+        generation: 7,
+        finding: ThreadHeadsUpFinding {
+            topic: "payment retries".to_string(),
+            summary: "Payment retries could double-charge customers.".to_string(),
+            explanation: "Use an **idempotency key** for each payment.\n\nKeep the same key when retrying the request.".to_string(),
+        },
+        expanded,
+    }
+}
+
+fn rendered(band: &HeadsUpBand, width: u16) -> String {
+    let area = Rect::new(
+        /*x*/ 0,
+        /*y*/ 0,
+        width,
+        band.desired_height(width),
+    );
+    let mut buffer = Buffer::empty(area);
+    band.render(area, &mut buffer);
+    (0..area.height)
+        .map(|y| {
+            (0..area.width)
+                .map(|x| buffer[(x, y)].symbol())
+                .collect::<String>()
+                .trim_end()
+                .to_string()
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+#[test]
+fn finding_snapshots() {
+    let (tx, _rx) = unbounded_channel();
+    let mut pane = super::super::tests::test_pane(AppEventSender::new(tx));
+    pane.set_heads_up(Some(note(/*expanded*/ false)));
+    let band = pane.heads_up.as_ref().unwrap();
+    assert_snapshot!("heads_up_compact", rendered(band, /*width*/ 64));
+    assert_snapshot!("heads_up_narrow", rendered(band, /*width*/ 30));
+    pane.set_heads_up(Some(note(/*expanded*/ true)));
+    assert_snapshot!(
+        "heads_up_explanation",
+        rendered(pane.heads_up.as_ref().unwrap(), /*width*/ 64)
+    );
+}
+
+#[test]
+fn shortcuts_keep_review_identity_and_work_during_a_turn() {
+    let (tx, mut rx) = unbounded_channel();
+    let mut pane = super::super::tests::test_pane(AppEventSender::new(tx));
+    let finding = note(/*expanded*/ false);
+    let thread_id = finding.thread_id;
+    pane.set_heads_up(Some(finding));
+    pane.set_task_running(/*running*/ true);
+    // Render the complete pane so the test also catches accidental task-time hiding.
+    let area = Rect::new(
+        /*x*/ 0,
+        /*y*/ 0,
+        /*width*/ 64,
+        pane.desired_height(/*width*/ 64),
+    );
+    pane.render(area, &mut Buffer::empty(area));
+    assert!(pane.handle_heads_up_key(KeyEvent::new(KeyCode::Char('1'), KeyModifiers::NONE)));
+    assert!(matches!(rx.try_recv().unwrap(), AppEvent::HeadsUpAction {
+        thread_id: id,
+        generation: 7,
+        action: HeadsUpAction::LearnMore,
+    } if id == thread_id));
+    pane.set_heads_up(Some(note(/*expanded*/ true)));
+    rendered(pane.heads_up.as_ref().unwrap(), /*width*/ 64);
+    assert!(pane.handle_heads_up_key(KeyEvent::new(KeyCode::Char('1'), KeyModifiers::NONE)));
+    assert!(matches!(
+        rx.try_recv().unwrap(),
+        AppEvent::HeadsUpAction {
+            action: HeadsUpAction::Chat,
+            ..
+        }
+    ));
+}
+
+#[test]
+fn send_and_dismiss_shortcuts_work_in_both_views() {
+    for expanded in [false, true] {
+        let (tx, mut rx) = unbounded_channel();
+        let mut pane = super::super::tests::test_pane(AppEventSender::new(tx));
+        let finding = note(expanded);
+        let thread_id = finding.thread_id;
+        pane.set_heads_up(Some(finding));
+        rendered(pane.heads_up.as_ref().unwrap(), /*width*/ 64);
+
+        for (key, expected) in [
+            ('3', HeadsUpAction::SendToAgent),
+            ('4', HeadsUpAction::Dismiss),
+        ] {
+            assert!(
+                pane.handle_heads_up_key(KeyEvent::new(KeyCode::Char(key), KeyModifiers::NONE))
+            );
+            let AppEvent::HeadsUpAction {
+                thread_id: id,
+                generation,
+                action,
+            } = rx.try_recv().unwrap()
+            else {
+                panic!("expected a Heads Up action")
+            };
+            assert_eq!((id, generation, action), (thread_id, 7, expected));
+        }
+    }
+}
+
+#[test]
+fn draft_and_clipped_controls_keep_their_keys() {
+    let (tx, mut rx) = unbounded_channel();
+    let mut pane = super::super::tests::test_pane(AppEventSender::new(tx));
+    pane.set_heads_up(Some(note(/*expanded*/ false)));
+    rendered(pane.heads_up.as_ref().unwrap(), /*width*/ 64);
+    pane.set_composer_text("draft".to_string(), Vec::new(), Vec::new());
+    for key in ['2', '3', '4'] {
+        assert!(!pane.handle_heads_up_key(KeyEvent::new(KeyCode::Char(key), KeyModifiers::NONE)));
+    }
+    assert!(!pane.handle_heads_up_key(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE)));
+    assert_eq!(pane.composer_text(), "draft");
+    assert!(rx.try_recv().is_err());
+    pane.set_composer_text(String::new(), Vec::new(), Vec::new());
+    let area = Rect::new(
+        /*x*/ 0, /*y*/ 0, /*width*/ 64, /*height*/ 1,
+    );
+    pane.heads_up
+        .as_ref()
+        .unwrap()
+        .render(area, &mut Buffer::empty(area));
+    for key in ['2', '3', '4'] {
+        assert!(!pane.handle_heads_up_key(KeyEvent::new(KeyCode::Char(key), KeyModifiers::NONE)));
+    }
+    assert!(rx.try_recv().is_err());
+}
+
+#[test]
+fn long_explanations_scroll_without_submitting_input() {
+    let (tx, mut rx) = unbounded_channel();
+    let mut pane = super::super::tests::test_pane(AppEventSender::new(tx));
+    let mut finding = note(/*expanded*/ true);
+    finding.finding.explanation = (0..20)
+        .map(|index| format!("Paragraph {index}.\n\n"))
+        .collect();
+    pane.set_heads_up(Some(finding));
+    let first = rendered(pane.heads_up.as_ref().unwrap(), /*width*/ 64);
+    assert!(first.contains("Paragraph 0."));
+    assert!(!first.contains("Paragraph 19."));
+    for _ in 0..8 {
+        assert!(pane.handle_heads_up_key(KeyEvent::new(KeyCode::PageDown, KeyModifiers::NONE)));
+    }
+    let last = rendered(pane.heads_up.as_ref().unwrap(), /*width*/ 64);
+    assert!(last.contains("Paragraph 19."));
+    assert!(last.contains("1 Discuss with agent"));
+    assert!(rx.try_recv().is_err());
+}
+
+#[test]
+fn existing_banner_keeps_numbered_actions_until_dismissed() {
+    let (tx, mut rx) = unbounded_channel();
+    let mut pane = super::super::tests::test_pane(AppEventSender::new(tx));
+    pane.set_heads_up(Some(note(/*expanded*/ false)));
+    pane.set_inline_banner(Some(super::super::ActionableBanner {
+        title: "Workspace notice".to_string(),
+        actions: vec![super::super::SelectionItem {
+            name: "Workspace action".to_string(),
+            ..Default::default()
+        }],
+        ..Default::default()
+    }));
+    for running in [false, true, false] {
+        pane.set_task_running(running);
+        let area = Rect::new(
+            /*x*/ 0,
+            /*y*/ 0,
+            /*width*/ 64,
+            pane.desired_height(/*width*/ 64),
+        );
+        pane.render(area, &mut Buffer::empty(area));
+        assert_eq!(pane.heads_up.as_ref().unwrap().visible.get(), running);
+    }
+    pane.handle_key_event(KeyEvent::new(KeyCode::Char('1'), KeyModifiers::NONE));
+    assert_eq!(pane.composer_text(), "");
+    assert!(rx.try_recv().is_err());
+    pane.handle_key_event(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+    assert!(pane.heads_up.is_some());
+    let area = Rect::new(
+        /*x*/ 0,
+        /*y*/ 0,
+        /*width*/ 64,
+        pane.desired_height(/*width*/ 64),
+    );
+    pane.render(area, &mut Buffer::empty(area));
+    assert!(pane.heads_up.as_ref().unwrap().visible.get());
+    pane.handle_key_event(KeyEvent::new(KeyCode::Char('1'), KeyModifiers::NONE));
+    assert!(matches!(
+        rx.try_recv().unwrap(),
+        AppEvent::HeadsUpAction {
+            action: HeadsUpAction::LearnMore,
+            ..
+        }
+    ));
+}
+
+#[test]
+fn heads_up_preserves_running_turn_interrupt_key() {
+    let (tx, mut rx) = unbounded_channel();
+    let mut pane = super::super::tests::test_pane(AppEventSender::new(tx));
+    pane.set_heads_up(Some(note(/*expanded*/ false)));
+    pane.set_task_running(/*running*/ true);
+    rendered(pane.heads_up.as_ref().unwrap(), /*width*/ 64);
+    let key = KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE);
+    assert!(!pane.handle_heads_up_key(key));
+    pane.handle_key_event(key);
+    assert!(matches!(
+        rx.try_recv().unwrap(),
+        AppEvent::CodexOp(crate::app_command::AppCommand::Interrupt)
+    ));
+    assert!(pane.heads_up.is_some());
+}
