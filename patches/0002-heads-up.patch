+use core_test_support::responses;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use std::time::Duration;
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn heads_up_reviews_retained_context_without_mutation_and_suppresses_known_topics()
+-> Result<()> {
+    let server = responses::start_mock_server().await;
+    let initial = responses::mount_sse_sequence(
+        &server,
+        vec![
+            responses::sse(vec![
+                responses::ev_function_call("prior-call", "unknown_heads_up_test_tool", "{}"),
+                responses::ev_completed("prior-tool"),
+            ]),
+            responses::sse(vec![
+                responses::ev_assistant_message(
+                    "initial",
+                    "I will delete the old database after migration.",
+                ),
+                responses::ev_completed("initial"),
+            ]),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
+            config
+                .features
+                .enable(codex_features::Feature::HeadsUp)
+                .expect("enable Heads Up");
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "The old database is our only backup.".into(),
+            text_elements: vec![],
