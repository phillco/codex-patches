@@ -0,0 +1,173 @@
+//! Optional reviewer findings above the composer, without changing its input or task state.
+
+use super::BottomPane;
+use crate::app_event::AppEvent;
+use crate::heads_up::HeadsUpAction;
+use crate::heads_up::HeadsUpNote;
+use crate::render::renderable::Renderable;
+use crate::wrapping::word_wrap_lines;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+use std::cell::Cell;
+
+pub(super) struct HeadsUpBand {
+    note: HeadsUpNote,
+    pub(super) visible: Cell<bool>,
+    actions_visible: Cell<bool>,
+    scroll: usize,
+    max_scroll: Cell<usize>,
+}
+
+impl HeadsUpBand {
+    fn lines(&self, width: u16) -> Vec<Line<'static>> {
+        let mut lines = vec![Line::from("Heads Up".bold().magenta())];
+        lines.extend(word_wrap_lines(
+            &[Line::from(self.note.finding.summary.clone())],
+            width as usize,
+        ));
+        if lines.len() > 4 {
+            lines.truncate(3);
+            lines.push("…".dim().into());
+        }
+        if self.note.expanded {
+            let mut explanation = Vec::new();
+            crate::markdown::append_markdown(
+                &self.note.finding.explanation,
+                Some(width as usize),
+                /*cwd*/ None,
+                &mut explanation,
+            );
+            let max_scroll = explanation.len().saturating_sub(/*rhs*/ 8);
+            self.max_scroll.set(max_scroll);
+            if max_scroll > 0 {
+                lines.push("PgUp/PgDn".dim().into());
+            }
+            lines.push(Line::default());
+            lines.extend(
+                explanation
+                    .into_iter()
+                    .skip(self.scroll.min(max_scroll))
+                    .take(/*n*/ 8),
+            );
+        }
+        lines.push(Line::default());
+        lines.extend(word_wrap_lines(
+            &[Line::from(
+                if self.note.expanded {
+                    "1 Discuss with agent · 2 Knew this already · 3 Send to agent · 4 Dismiss"
+                } else {
+                    "1 Learn more · 2 Knew this already · 3 Send to agent · 4 Dismiss"
+                }
+                .cyan(),
+            )],
+            width as usize,
+        ));
+        lines.push(Line::default());
+        lines
+    }
+}
+
+impl Renderable for HeadsUpBand {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let lines = self.lines(area.width);
+        self.visible.set(!area.is_empty());
+        // Never intercept a shortcut when terminal clipping has hidden its controls.
+        self.actions_visible
+            .set(!area.is_empty() && area.height as usize >= lines.len());
+        Widget::render(Paragraph::new(lines), area, buf);
+    }
+
+    fn desired_height(&self, width: u16) -> u16 {
+        self.lines(width).len() as u16
+    }
+}
+
+impl BottomPane {
+    pub(crate) fn append_draft_text(&mut self, text: &str) -> Result<(), &'static str> {
+        if self.has_active_view() || self.questions.as_ref().is_some_and(|q| q.expanded) {
+            return Err("A dialog or question editor is active");
+        }
+        self.composer.append_draft_text(text)?;
+        self.record_composer_activity_at(std::time::Instant::now());
+        self.request_redraw();
+        Ok(())
+    }
+    pub(crate) fn set_heads_up(&mut self, note: Option<HeadsUpNote>) {
+        self.heads_up = note.map(|note| HeadsUpBand {
+            note,
+            visible: Cell::new(false),
+            actions_visible: Cell::new(false),
+            scroll: 0,
+            max_scroll: Cell::new(0),
+        });
+        self.request_redraw();
+    }
+
+    pub(super) fn handle_heads_up_key(&mut self, key: KeyEvent) -> bool {
+        if self.should_interrupt_running_task(key)
+            || !self.composer_is_empty()
+            || !self.view_stack.is_empty()
+            || self
+                .questions
+                .as_ref()
+                .is_some_and(|questions| questions.expanded)
+            || self.composer.popup_active()
+            || self.composer.is_in_paste_burst()
+            || self.composer_should_handle_vim_insert_escape(key)
+            || key.kind != KeyEventKind::Press
+            || key.modifiers != KeyModifiers::NONE
+        {
+            return false;
+        }
+        let Some(band) = &mut self.heads_up else {
+            return false;
+        };
+        if !band.visible.get() {
+            return false;
+        }
+        if band.note.expanded
+            && band.actions_visible.get()
+            && matches!(key.code, KeyCode::PageUp | KeyCode::PageDown)
+        {
+            band.scroll = if key.code == KeyCode::PageUp {
+                band.scroll.saturating_sub(/*rhs*/ 8)
+            } else {
+                (band.scroll + 8).min(band.max_scroll.get())
+            };
+            self.request_redraw();
+            return true;
+        }
+        let action = match key.code {
+            KeyCode::Esc => HeadsUpAction::Dismiss,
+            KeyCode::Char('1') if band.actions_visible.get() => {
+                if band.note.expanded {
+                    HeadsUpAction::Chat
+                } else {
+                    HeadsUpAction::LearnMore
+                }
+            }
+            KeyCode::Char('2') if band.actions_visible.get() => HeadsUpAction::Knew,
+            KeyCode::Char('3') if band.actions_visible.get() => HeadsUpAction::SendToAgent,
+            KeyCode::Char('4') if band.actions_visible.get() => HeadsUpAction::Dismiss,
+            _ => return false,
+        };
+        self.app_event_tx.send(AppEvent::HeadsUpAction {
+            thread_id: band.note.thread_id,
+            generation: band.note.generation,
+            action,
+        });
+        true
+    }
+}
