+    let compact_parent = async {
+        tokio::time::timeout(Duration::from_secs(/*secs*/ 5), async {
+            while reviews.requests().is_empty() {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await?;
+        test.codex.submit(Op::Compact).await?;
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        })
+        .await;
+        if sample_parent {
+            test.codex
+                .start_or_steer_turn(
+                    TurnInputRequest::user_input(vec![UserInput::Text {
+                        text: "Verify the deletion risk now.".into(),
+                        text_elements: vec![],
+                    }])
+                    .with_thread_settings(ThreadSettingsOverrides {
+                        effort: Some(Some(ReasoningEffort::Low)),
+                        ..Default::default()
+                    }),
+                )
+                .await?;
+            wait_for_event(&test.codex, |event| {
+                matches!(event, EventMsg::TurnComplete(_))
+            })
+            .await;
+        } else {
+            // Let the retry encounter compacted history before the parent restores its
+            // initial instructions. It must wait rather than review incomplete context.
+            tokio::time::sleep(Duration::from_secs(/*secs*/ 12)).await;
+            assert_eq!(reviews.requests().len(), 2);
+            // Inject new retained context without sampling or replacing the captured baseline.
+            test.codex
+                .inject_response_items(serde_json::from_value(serde_json::json!([{
+                    "type": "message",
+                    "role": "user",
+                    "content": [{"type": "input_text", "text": "Verify the deletion risk now."}],
+                }]))?)
+                .await?;
+        }
+        Ok::<_, anyhow::Error>(test.codex.conversation_history_snapshot().await)
+    };
+    let (review, after_compaction) =
+        tokio::join!(test.codex.review_heads_up(vec![]), compact_parent);
+    assert_eq!(review?, Some(finding));
+    let after_compaction = after_compaction?;
+    let requests = reviews.requests();
+    assert_eq!(requests.len(), if sample_parent { 4 } else { 3 });
+    let retried = requests.last().expect("retried review request");
+    let body = retried.body_json();
+    assert_eq!(body["tool_choice"], "none");
+    assert_ne!(body["input"], requests[0].body_json()["input"]);
+    assert!(retried.body_contains_text(summary));
+    assert!(retried.body_contains_text("Preserve the remaining database backup."));
+    let baseline = if sample_parent {
+        let baseline = requests[2].body_json();
+        let prefix = baseline["input"].as_array().expect("parent input array");
+        assert_eq!(
+            &body["input"].as_array().expect("review input array")[..prefix.len()],
+            prefix
+        );
+        assert!(retried.body_contains_text("Verify the deletion risk now."));
+        assert!(retried.body_contains_text("I will verify the deletion risk."));
+        baseline
+    } else {
+        original_body
+    };
+    for key in [
+        "model",
+        "instructions",
+        "tools",
+        "reasoning",
+        "prompt_cache_key",
+    ] {
+        assert_eq!(body[key], baseline[key], "review changed {key}");
+    }
+    assert_eq!(
+        after_compaction.items().collect::<Vec<_>>(),
+        test.codex
+            .conversation_history_snapshot()
+            .await
+            .items()
+            .collect::<Vec<_>>()
+    );
+    Ok(())
+}
