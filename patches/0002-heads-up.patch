+                .expect("enable Heads Up");
+            config.model_provider.request_max_retries = Some(0);
+            config.model_provider.stream_max_retries = Some(0);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "The old database is our only backup.".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let parent_body = parent.single_request().body_json();
+    let requests = responses::mount_sse_sequence(
+        &server,
+        vec![
+            responses::sse_failed("failed", "rate_limit_exceeded", "Try again in 10s."),
+            responses::sse(vec![
+                responses::ev_assistant_message("new-parent", "I will delete it anyway."),
+                responses::ev_completed("new-parent"),
+            ]),
+            responses::sse(vec![
+                responses::ev_assistant_message("review", "{\"finding\":null}"),
+                responses::ev_completed("review"),
+            ]),
+        ],
+    )
+    .await;
+    let advance_parent = async {
+        tokio::time::timeout(Duration::from_secs(/*secs*/ 5), async {
+            while requests.requests().is_empty() {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await?;
+        test.codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "The backup copy failed.".into(),
+                text_elements: vec![],
+            }]))
+            .await?;
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        })
+        .await;
+        Ok::<_, anyhow::Error>(test.codex.conversation_history_snapshot().await)
+    };
+    let (finding, after_parent) = tokio::join!(test.codex.review_heads_up(vec![]), advance_parent);
+    assert_eq!(finding?, None);
+    let after_parent = after_parent?;
+    let requests = requests.requests();
+    assert_eq!(requests.len(), 3);
+    let mut first_body = requests[0].body_json();
+    let mut retried_body = requests[2].body_json();
+    assert_eq!(first_body["tool_choice"], "none");
+    assert_eq!(retried_body["tool_choice"], "none");
+    let first_input = first_body.as_object_mut().unwrap().remove("input").unwrap();
+    let retried_input = retried_body
+        .as_object_mut()
+        .unwrap()
+        .remove("input")
+        .unwrap();
+    let first_metadata = first_body
+        .as_object_mut()
+        .unwrap()
+        .remove("client_metadata")
+        .unwrap();
+    let retried_metadata = retried_body
+        .as_object_mut()
+        .unwrap()
+        .remove("client_metadata")
+        .unwrap();
+    assert_eq!(first_metadata, parent_body["client_metadata"]);
+    assert_eq!(retried_metadata, requests[1].body_json()["client_metadata"]);
+    assert_eq!(first_body, retried_body);
+    let first_input = first_input.as_array().unwrap();
+    let retried_input = retried_input.as_array().unwrap();
+    let prefix = parent_body["input"].as_array().unwrap();
+    assert_eq!(&first_input[..prefix.len()], prefix);
+    assert_eq!(
+        &retried_input[..first_input.len() - 1],
+        &first_input[..first_input.len() - 1]
+    );
+    assert_eq!(retried_input.last(), first_input.last());
+    let reviewed: Vec<ResponseItem> =
+        serde_json::from_value(serde_json::Value::Array(requests[2].input()))?;
+    for (role, expected) in [
+        ("user", "The old database is our only backup."),
+        ("assistant", "I will delete the old database."),
+        ("user", "The backup copy failed."),
+        ("assistant", "I will delete it anyway."),
+    ] {
+        assert!(
+            reviewed.iter().any(|item| matches!(item,
+                ResponseItem::Message { role: actual_role, content, .. }
+                if actual_role == role && content.iter().any(|content| matches!(content,
+                    ContentItem::InputText { text } | ContentItem::OutputText { text }
+                    if text == expected
+                ))
+            )),
+            "retried review is missing {expected}"
+        );
+    }
+    assert_eq!(
+        after_parent.items().collect::<Vec<_>>(),
+        test.codex
+            .conversation_history_snapshot()
+            .await
+            .items()
+            .collect::<Vec<_>>()
+    );
+    Ok(())
+}
