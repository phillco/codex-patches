diff --git a/codex-rs/tui/src/chatwidget/heads_up.rs b/codex-rs/tui/src/chatwidget/heads_up.rs
new file mode 100644
index 00000000000000000000..5df6cf0a5165c7f42b17
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/heads_up.rs
@@ -0,0 +1,246 @@
+//! Scheduling and actions for the optional conversation reviewer.
+
+use super::ChatWidget;
+use super::UserMessageHistoryRecord;
+use crate::app_event::AppEvent;
+use crate::heads_up::HeadsUpAction;
+use crate::heads_up::HeadsUpNote;
+use crate::heads_up::load_known;
+use crate::heads_up::remember;
+use codex_app_server_protocol::ThreadHeadsUpFinding;
+use codex_protocol::ThreadId;
+
+impl ChatWidget {
+    pub(crate) fn detach_heads_up(&mut self) {
+        if self.heads_up.enabled
+            && let Some(thread_id) = self.thread_id
+        {
+            self.app_event_tx.send(AppEvent::SetHeadsUpCapture {
+                thread_id,
+                enabled: false,
+            });
+        }
+        self.reset_heads_up();
+    }
+
+    pub(super) fn heads_up_turn_started(&mut self) {
+        self.heads_up.steps = 0;
+        self.heads_up.completion_pending = false;
+        // A review from the previous turn may still have something useful to say.
+        // Deliver it even if the user has already started more work.
+        self.heads_up.refreshing_after_progress = self.heads_up.pending.is_some();
+    }
+
+    pub(super) fn reset_heads_up(&mut self) {
+        self.heads_up.epoch = self.heads_up.epoch.wrapping_add(1);
+        self.heads_up.pending = None;
+        self.heads_up.note = None;
+        self.bottom_pane.set_heads_up(/*note*/ None);
+        self.heads_up_turn_started();
+    }
+
+    pub(super) fn heads_up_step_completed(&mut self) {
+        self.heads_up.steps += 1;
+        if self.heads_up.steps >= 6 {
+            self.request_heads_up();
+        }
+    }
+
+    pub(super) fn heads_up_turn_completed(&mut self) {
+        self.heads_up.completion_pending = true;
+        self.request_heads_up();
+    }
+
+    fn request_heads_up(&mut self) {
+        let Some(thread_id) = self.thread_id() else {
+            return;
+        };
+        let Some(generation) = self.heads_up.begin_request() else {
+            return;
+        };
+        let mut known = load_known(self.config.codex_home.as_path()).unwrap_or_else(|error| {
+            tracing::warn!(%error, "could not load Heads Up knowledge");
+            Vec::new()
+        });
+        for topic in &self.heads_up.seen {
+            if !known.iter().any(|known| known.eq_ignore_ascii_case(topic)) {
+                known.push(topic.clone());
+            }
+        }
+        known.drain(..known.len().saturating_sub(/*rhs*/ 64));
+        self.app_event_tx.send(AppEvent::RequestHeadsUp {
+            thread_id,
+            generation,
+            known,
+        });
+    }
+
+    pub(crate) fn on_heads_up_result(
+        &mut self,
+        thread_id: ThreadId,
+        generation: u64,
+        result: Result<Option<ThreadHeadsUpFinding>, String>,
+    ) {
+        if self.thread_id() != Some(thread_id) {
+            return;
+        }
+        if self.heads_up.accept_result(generation) {
+            // Include newer steps in one fresh pass, without endlessly discarding results
+            // while the parent continues working. Each retry also expands its own context.
+            if self.heads_up.steps > 0 && !self.heads_up.refreshing_after_progress {
+                self.heads_up.refreshing_after_progress = true;
+                self.request_heads_up();
+                return;
+            }
+            self.heads_up.refreshing_after_progress = false;
+            match result {
+                Ok(Some(finding)) => {
+                    if let Err(error) = crate::heads_up::remember_seen(
+                        self.config.codex_home.as_path(),
+                        thread_id,
+                        &finding.topic,
+                    ) {
+                        tracing::warn!(%error, "could not save seen Heads Up topic");
+                    }
+                    self.heads_up.seen.push(finding.topic.clone());
+                    self.heads_up
+                        .seen
+                        .drain(..self.heads_up.seen.len().saturating_sub(/*rhs*/ 64));
+                    self.heads_up.note = Some(HeadsUpNote {
+                        thread_id,
+                        generation,
+                        finding,
+                        expanded: self.config.tui_heads_up_expanded,
+                    });
+                    self.bottom_pane.set_heads_up(self.heads_up.note.clone());
+                }
+                Ok(None) => {}
+                Err(error) => {
+                    tracing::warn!(%error, "Heads Up review failed");
+                    self.add_info_message(
+                        format!("Heads Up review failed: {error}"),
+                        /*hint*/ None,
+                    );
+                }
+            }
+        }
+        if self.heads_up.completion_pending {
+            self.request_heads_up();
+        }
+        self.request_redraw();
+    }
+
+    pub(crate) fn heads_up_action(
+        &mut self,
+        thread_id: ThreadId,
+        generation: u64,
+        action: HeadsUpAction,
+    ) {
+        let Some(note) = &mut self.heads_up.note else {
+            return;
+        };
+        if note.thread_id != thread_id
+            || note.generation != generation
+            || self.thread_id != Some(thread_id)
+        {
+            return;
+        }
+        match action {
+            HeadsUpAction::LearnMore => {
+                note.expanded = true;
+                self.bottom_pane.set_heads_up(Some(note.clone()));
+            }
+            HeadsUpAction::Knew => {
+                if let Err(error) = remember(self.config.codex_home.as_path(), &note.finding.topic)
+                {
+                    self.add_error_message(format!("Could not save Heads Up topic: {error}"));
+                    return;
+                }
+                self.heads_up.note = None;
+                self.bottom_pane.set_heads_up(/*note*/ None);
+            }
+            HeadsUpAction::Dismiss => {
+                self.heads_up.note = None;
+                self.bottom_pane.set_heads_up(/*note*/ None);
+            }
+            HeadsUpAction::Chat => {
+                let mut message = note.agent_prompt();
+                if !self.bottom_pane.composer_text_with_pending().is_empty()
+                    || self.bottom_pane.is_in_paste_burst()
+                {
+                    message.insert_str(/*idx*/ 0, "\n\n");
+                }
+                if let Err(error) = self.bottom_pane.append_draft_text(&message) {
+                    self.add_error_message(format!("Could not insert Heads Up note: {error}"));
+                    return;
+                }
+                self.heads_up.note = None;
+                self.bottom_pane.set_heads_up(/*note*/ None);
+            }
+            HeadsUpAction::SendToAgent => {
+                let message = note.agent_prompt().into();
+                if self.blocks_direct_input
+                    || !self.bottom_pane.composer_input_enabled()
+                    || !self.bottom_pane.no_modal_or_popup_active()
+                    || self
+                        .effective_collaboration_mode()
+                        .model()
+                        .trim()
+                        .is_empty()
+                {
+                    self.add_error_message(
+                        "Cannot send Heads Up note while input is unavailable.".to_string(),
+                    );
+                    return;
+                }
+                let accepted = if self.is_plan_streaming_in_tui()
+                    || self.input_queue.suppress_queue_autosend
+                    || self.only_user_shell_commands_running()
+                    || self.input_queue.user_turn_pending_start
+                        && !self.turn_lifecycle.agent_turn_running
+                        && !self.input_queue.can_steer_pending_start()
+                {
+                    self.queue_user_message(message)
+                } else {
+                    self.submit_user_message_with_history_record(
+                        message,
+                        UserMessageHistoryRecord::UserMessageText,
+                    )
+                };
+                if !accepted {
+                    return;
+                }
+                self.heads_up.note = None;
+                self.bottom_pane.set_heads_up(/*note*/ None);
+            }
+        }
+        self.request_redraw();
+    }
+
+    pub(super) fn toggle_heads_up(&mut self) {
+        let enabled = !self.heads_up.enabled;
+        if let Err(error) = self
+            .config
+            .features
+            .set_enabled(codex_features::Feature::HeadsUp, enabled)
+        {
+            self.add_error_message(format!("Could not change Heads Up setting: {error}"));
+            return;
+        }
+        self.heads_up.enabled = enabled;
+        self.reset_heads_up();
+        if let Some(thread_id) = self.thread_id {
+            self.app_event_tx
+                .send(AppEvent::SetHeadsUpCapture { thread_id, enabled });
+        }
+        self.app_event_tx
+            .send(AppEvent::SaveHeadsUpEnabled(self.heads_up.enabled));
+        self.add_info_message(
+            format!(
+                "Heads Up {}",
+                if self.heads_up.enabled { "on" } else { "off" }
+            ),
+            /*hint*/ None,
+        );
+    }
+}
