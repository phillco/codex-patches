index 00000000000000000000..b6bab9b840796cd501ef
--- /dev/null
+++ b/codex-rs/tui/src/heads_up.rs
@@ -0,0 +1,173 @@
+//! Native reviewer state and bounded, shared known-topic storage.
+
+use codex_app_server_protocol::ThreadHeadsUpFinding;
+use codex_protocol::ThreadId;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io::Read;
+use std::io::Write;
+use std::path::Path;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+static NEXT_REVIEW: AtomicU64 = AtomicU64::new(/*v*/ 1);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum HeadsUpAction {
+    LearnMore,
+    Knew,
+    Dismiss,
+    Chat,
+    SendToAgent,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct HeadsUpNote {
+    pub thread_id: ThreadId,
+    pub generation: u64,
+    pub finding: ThreadHeadsUpFinding,
+    pub expanded: bool,
+}
+
+impl HeadsUpNote {
+    pub fn agent_prompt(&self) -> String {
+        let finding = format!(
+            "Heads up · {}\n\n{}",
+            self.finding.summary, self.finding.explanation
+        );
+        let mut message = String::from("Here is a note offered by a side agent:\n\n");
+        for line in finding.lines() {
+            message.push('>');
+            if !line.is_empty() {
+                message.push(' ');
+                message.push_str(line);
+            }
+            message.push('\n');
+        }
+        message.push('\n');
+        message
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct HeadsUpState {
+    pub enabled: bool,
+    pub epoch: u64,
+    pub steps: usize,
+    pub pending: Option<(u64, u64)>,
+    pub completion_pending: bool,
+    /// One expanded-context follow-up is enough; continuous work must not starve findings.
+    pub refreshing_after_progress: bool,
+    pub note: Option<HeadsUpNote>,
+    pub seen: Vec<String>,
+}
+
+impl HeadsUpState {
+    pub fn begin_request(&mut self) -> Option<u64> {
+        if !self.enabled || self.pending.is_some() || self.note.is_some() {
+            return None;
+        }
+        let generation = NEXT_REVIEW.fetch_add(/*val*/ 1, Ordering::Relaxed);
+        self.pending = Some((generation, self.epoch));
+        self.steps = 0;
+        self.completion_pending = false;
+        Some(generation)
+    }
+
+    pub fn accept_result(&mut self, generation: u64) -> bool {
+        let Some((pending, epoch)) = self.pending else {
+            return false;
+        };
+        if pending != generation {
+            return false;
+        }
+        self.pending = None;
+        self.enabled && epoch == self.epoch
+    }
+}
+
+pub(crate) fn load_known(home: &Path) -> std::io::Result<Vec<String>> {
+    load_topics(&home.join("heads-up-known.json"))
+}
+
+pub(crate) fn load_seen(home: &Path, thread_id: ThreadId) -> std::io::Result<Vec<String>> {
+    load_topics(&home.join("heads-up").join(format!("{thread_id}.json")))
+}
+
+fn valid_topic(topic: &str) -> bool {
+    !topic.trim().is_empty()
+        && topic.chars().count() <= 64
+        && !topic.chars().any(|character| {
+            character.is_control()
+                || matches!(
+                    character,
+                    '\u{061c}'
+                        | '\u{200e}'
+                        | '\u{200f}'
+                        | '\u{202a}'..='\u{202e}'
+                        | '\u{2066}'..='\u{2069}'
+                )
+        })
+}
+
+fn load_topics(path: &Path) -> std::io::Result<Vec<String>> {
+    let file = match File::open(path) {
+        Ok(file) => file,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(error) => return Err(error),
+    };
+    let mut bytes = Vec::new();
+    file.take(/*limit*/ 32_769).read_to_end(&mut bytes)?;
+    if bytes.len() > 32_768 {
+        return Err(std::io::Error::other(
+            "Heads Up knowledge exceeds its limit",
+        ));
+    }
+    let topics: Vec<String> = serde_json::from_slice(&bytes)?;
+    if topics.len() > 64 || !topics.iter().all(|topic| valid_topic(topic)) {
+        return Err(std::io::Error::other("Invalid Heads Up knowledge"));
+    }
+    Ok(topics)
+}
+
+pub(crate) fn remember(home: &Path, topic: &str) -> std::io::Result<()> {
+    remember_topic(&home.join("heads-up-known.json"), topic)
+}
+
+pub(crate) fn remember_seen(home: &Path, thread_id: ThreadId, topic: &str) -> std::io::Result<()> {
+    remember_topic(
+        &home.join("heads-up").join(format!("{thread_id}.json")),
+        topic,
+    )
+}
+
+fn remember_topic(path: &Path, topic: &str) -> std::io::Result<()> {
+    if !valid_topic(topic) {
+        return Err(std::io::Error::other("Invalid Heads Up topic"));
+    }
+    let parent = path
+        .parent()
+        .ok_or_else(|| std::io::Error::other("Heads Up topic storage has no parent directory"))?;
+    std::fs::create_dir_all(parent)?;
+    // Separate lock file allows atomic replacement of data on Windows too.
+    let lock = OpenOptions::new()
+        .create(true)
+        .truncate(false)
+        .read(true)
+        .write(true)
+        .open(path.with_extension("lock"))?;
+    lock.try_lock().map_err(std::io::Error::other)?;
+    let mut known = load_topics(path)?;
+    known.retain(|item| !item.eq_ignore_ascii_case(topic));
+    known.push(topic.to_owned());
+    let known = &known[known.len().saturating_sub(/*rhs*/ 64)..];
+    let mut file = tempfile::NamedTempFile::new_in(parent)?;
+    file.write_all(&serde_json::to_vec(known)?)?;
+    file.as_file().sync_all()?;
+    file.persist(path)?;
+    Ok(())
+}
