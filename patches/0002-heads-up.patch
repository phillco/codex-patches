diff --git a/codex-rs/tui/src/app/heads_up.rs b/codex-rs/tui/src/app/heads_up.rs
new file mode 100644
index 00000000000000000000..b6ec0b704ac866e9ca30
--- /dev/null
+++ b/codex-rs/tui/src/app/heads_up.rs
@@ -0,0 +1,71 @@
+//! Background reviewer requests leave the app event loop and main turn responsive.
+
+use super::App;
+use crate::app_event::AppEvent;
+use codex_app_server_client::AppServerRequestHandle;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ThreadHeadsUpParams;
+use codex_app_server_protocol::ThreadHeadsUpResponse;
+use codex_protocol::ThreadId;
+use std::time::Duration;
+
+impl App {
+    pub(super) async fn set_heads_up_capture(
+        &mut self,
+        handle: AppServerRequestHandle,
+        thread_id: ThreadId,
+        enabled: bool,
+    ) {
+        let result = handle
+            .request_typed::<codex_app_server_protocol::ThreadHeadsUpSetEnabledResponse>(
+                ClientRequest::ThreadHeadsUpSetEnabled {
+                    request_id: RequestId::String(format!("heads-up-enabled-{thread_id}")),
+                    params: codex_app_server_protocol::ThreadHeadsUpSetEnabledParams {
+                        thread_id: thread_id.to_string(),
+                        enabled,
+                    },
+                },
+            )
+            .await;
+        if let Err(error) = result {
+            self.chat_widget
+                .add_error_message(format!("Could not change Heads Up capture: {error}"));
+        }
+    }
+
+    pub(super) fn request_heads_up(
+        &self,
+        handle: AppServerRequestHandle,
+        thread_id: ThreadId,
+        generation: u64,
+        known: Vec<String>,
+    ) {
+        if self.chat_widget.thread_id() != Some(thread_id) {
+            return;
+        }
+        let tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let request =
+                handle.request_typed::<ThreadHeadsUpResponse>(ClientRequest::ThreadHeadsUp {
+                    request_id: RequestId::String(format!("heads-up-{generation}")),
+                    params: ThreadHeadsUpParams {
+                        thread_id: thread_id.to_string(),
+                        known: Some(known),
+                    },
+                });
+            // Core allows up to seven minutes for bounded review attempts and backoff.
+            let result =
+                match tokio::time::timeout(Duration::from_secs(/*secs*/ 450), request).await {
+                    Ok(Ok(response)) => Ok(response.finding),
+                    Ok(Err(error)) => Err(error.to_string()),
+                    Err(_) => Err("review timed out".to_string()),
+                };
+            tx.send(AppEvent::HeadsUpResult {
+                thread_id,
+                generation,
+                result,
+            });
+        });
+    }
+}
