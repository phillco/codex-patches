+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn parses_two_dot_ranges() {
+    assert_eq!(
+        parse_range_spec("main..feature").expect("valid range"),
+        ("main".to_string(), "feature".to_string())
+    );
+    assert_eq!(
+        parse_range_spec(" abc123 .. def456 ").expect("valid range with spaces"),
+        ("abc123".to_string(), "def456".to_string())
+    );
+}
+
+#[test]
+fn rejects_malformed_ranges() {
+    for spec in ["main", "main...feature", "..feature", "main..", ""] {
+        assert!(
+            parse_range_spec(spec).is_err(),
+            "expected '{spec}' to be rejected"
+        );
+    }
+}
+
+#[test]
+fn renders_range_instructions_with_focus() {
+    let range = CommitRange {
+        base: "aaaa".to_string(),
+        head: "bbbb".to_string(),
+        commits: vec!["1111111".to_string(), "2222222".to_string()],
+    };
+    let expected = "Review commit range aaaa..bbbb (2 commits).\n\nRun `git diff aaaa bbbb` for combined changes and `git log -p aaaa..bbbb` for individual commits. Review only this range. Provide prioritized, actionable findings.\n\nAdditional focus: concurrency";
+    assert_eq!(
+        range_review_instructions(&range, Some("  concurrency ")),
+        expected
+    );
+    assert_eq!(range_hint(&range), "2 commits aaaa..bbbb");
+}
+
+fn git(dir: &Path, args: &[&str]) -> String {
+    run(dir, "git", args).expect("git command succeeds")
+}
+
+fn commit(dir: &Path, message: &str) -> String {
+    std::fs::write(dir.join("file.txt"), message).expect("write file");
+    git(dir, &["add", "file.txt"]);
+    git(
+        dir,
+        &[
+            "-c",
+            "user.name=t",
+            "-c",
+            "user.email=t@t",
+            "-c",
+            "commit.gpgSign=false",
+            "commit",
+            "-qm",
+            message,
+        ],
+    );
+    git(dir, &["rev-parse", "HEAD"]).trim().to_string()
+}
+
+#[test]
+fn resolves_git_ranges_oldest_first() {
+    let repo = tempfile::tempdir().expect("tempdir");
+    git(repo.path(), &["init", "-q"]);
+    let base = commit(repo.path(), "base");
+    let first = commit(repo.path(), "one");
+    let head = commit(repo.path(), "two");
+
+    let range = resolve_git_range(repo.path(), &base, "HEAD").expect("resolves range");
+    assert_eq!(
+        range,
+        CommitRange {
+            base,
+            head: head.clone(),
+            commits: vec![first, head]
+        }
+    );
+
+    assert!(
+        resolve_git_range(repo.path(), "HEAD", "HEAD").is_err(),
+        "empty range"
+    );
+    assert!(
+        resolve_git_range(repo.path(), "no-such-ref", "HEAD").is_err(),
+        "unknown base"
+    );
+}
+
+#[test]
+fn range_instructions_keep_generated_text_small_and_preserve_long_focus() {
+    let range = CommitRange {
+        base: "a".repeat(64),
+        head: "b".repeat(64),
+        commits: vec!["c".repeat(64); 10_000],
+    };
+    let generated = range_review_instructions(&range, None);
+    assert!(generated.len() < 1000);
+    assert!(generated.contains("10000 commits"));
+    let focus = "Review concurrency and rollback. Vérifier les erreurs.\n\n".repeat(100);
+    let instructions = range_review_instructions(&range, Some(&focus));
+    assert_eq!(
+        instructions,
+        format!("{generated}\n\nAdditional focus: {}", focus.trim())
+    );
+}
+
+#[test]
+fn rejects_divergent_git_range_endpoints() {
+    let repo = tempfile::tempdir().expect("tempdir");
+    git(repo.path(), &["init", "-q"]);
+    let root = commit(repo.path(), "root");
+    let left = commit(repo.path(), "left");
+    git(repo.path(), &["checkout", "--detach", &root]);
+    let right = commit(repo.path(), "right");
+    let error = resolve_git_range(repo.path(), &left, &right).expect_err("divergent endpoints");
+    assert!(error.to_string().contains("ancestor"));
+}
+
+#[test]
+fn jj_ranges_preserve_selection_and_include_current_working_copy() {
+    match Command::new("jj").arg("--version").output() {
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            eprintln!("skipping jj range test: jj is not installed");
+            return;
+        }
+        Ok(output) => assert!(output.status.success(), "jj --version failed"),
+        Err(error) => panic!("failed to check jj: {error}"),
+    }
+    let repo = tempfile::tempdir().expect("tempdir");
+    let dir = repo.path();
+    git(dir, &["init", "-q"]);
+    let base = commit(dir, "base");
+    let one = commit(dir, "one");
+    let two = commit(dir, "two");
+    let three = commit(dir, "three");
+    // Build a side branch and merge without checkout conflicts or shell scripts.
+    let tree = git(dir, &["rev-parse", "HEAD^{tree}"]);
+    let side = git(
+        dir,
+        &[
+            "-c",
+            "user.name=t",
+            "-c",
+            "user.email=t@t",
+            "-c",
+            "commit.gpgSign=false",
+            "commit-tree",
+            tree.trim(),
+            "-p",
+            &base,
+            "-m",
+            "side",
+        ],
+    );
+    let merge = git(
+        dir,
+        &[
+            "-c",
+            "user.name=t",
+            "-c",
+            "user.email=t@t",
+            "-c",
+            "commit.gpgSign=false",
+            "commit-tree",
+            tree.trim(),
+            "-p",
+            &three,
+            "-p",
+            side.trim(),
+            "-m",
+            "merge",
+        ],
+    );
+    git(dir, &["branch", "merge", merge.trim()]);
+    run(dir, "jj", &["git", "init", "--colocate", "."]).expect("init colocated jj");
+    let working_copy = run(
+        dir,
+        "jj",
+        &[
+            "--ignore-working-copy",
+            "log",
+            "--no-graph",
+            "-r",
+            "@",
+            "-T",
+            "commit_id",
+        ],
+    )
+    .expect("working copy ID");
+    let edited_contents = "current working-copy changes";
+    std::fs::write(dir.join("file.txt"), edited_contents).expect("edit working copy");
+    let current = resolve_jj_revset(dir, "@").expect("current working-copy range");
+    let current_id = current.head.clone();
+    assert_ne!(current_id, working_copy.trim());
+    assert_eq!(
+        current,
+        CommitRange {
+            base: three.clone(),
+            head: current_id.clone(),
+            commits: vec![current_id.clone()],
+        }
+    );
+    assert_eq!(
+        git(dir, &["show", &format!("{current_id}:file.txt")]),
+        edited_contents
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.join("file.txt")).expect("working-copy contents"),
+        edited_contents
+    );
+    let range = resolve_jj_revset(dir, &format!("{one}::{three}")).expect("linear jj range");
+    assert_eq!(
+        range,
+        CommitRange {
+            base,
+            head: three.clone(),
+            commits: vec![one.clone(), two, three.clone()],
+        }
+    );
+    assert!(
+        resolve_jj_revset(dir, &format!("{one} | {three}")).is_err(),
+        "gapped selection"
+    );
+    assert!(
+        resolve_jj_revset(dir, &format!("{one} | {}", side.trim())).is_err(),
+        "branched selection"
+    );
+    assert!(
+        resolve_jj_revset(dir, &format!("{one}::{three} | {}", merge.trim())).is_err(),
+        "merge importing unselected side branch"
+    );
+    assert!(resolve_jj_revset(dir, "none()").is_err(), "empty selection");
+}
