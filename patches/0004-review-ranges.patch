+use core_test_support::responses;
+use core_test_support::test_codex_exec::test_codex_exec;
+use pretty_assertions::assert_eq;
+use std::path::Path;
+use std::process::Command;
+
+fn git(cwd: &Path, args: &[&str]) -> anyhow::Result<String> {
+    let output = Command::new("git")
+        .current_dir(cwd)
+        .env("JJ_GIT_OK", "1")
+        .args([
+            "-c",
+            "user.name=Review Range Test",
+            "-c",
+            "user.email=test@example.invalid",
+            "-c",
+            "commit.gpgSign=false",
+        ])
+        .args(args)
+        .output()?;
+    anyhow::ensure!(
+        output.status.success(),
+        "git failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    Ok(String::from_utf8(output.stdout)?.trim().to_string())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn review_range_sends_resolved_endpoints_and_focus_without_mutating_checkout()
+-> anyhow::Result<()> {
+    let test = test_codex_exec();
+    let cwd = test.cwd_path();
+    git(cwd, &["init", "-q"])?;
+    std::fs::write(cwd.join("reviewed.txt"), "before\n")?;
+    git(cwd, &["add", "reviewed.txt"])?;
+    git(
+        cwd,
+        &["commit", "-qm", "base subject not needed in model context"],
+    )?;
+    let base = git(cwd, &["rev-parse", "HEAD"])?;
+    std::fs::write(cwd.join("reviewed.txt"), "after\n")?;
+    git(cwd, &["commit", "-qam", "unique-review-range-subject"])?;
+    let head = git(cwd, &["rev-parse", "HEAD"])?;
+    std::fs::write(cwd.join("reviewed.txt"), "uncommitted work\n")?;
+    let before = git(cwd, &["status", "--porcelain"])?;
+
+    let server = responses::start_mock_server().await;
+    let mock = responses::mount_sse_once(
+        &server,
+        responses::sse(vec![
+            responses::ev_response_created("review-response"),
+            responses::ev_assistant_message(
+                "review-message",
+                r#"{"findings":[],"overall_correctness":"patch is correct","overall_explanation":"No issues found.","overall_confidence_score":0.9}"#,
+            ),
+            responses::ev_completed("review-response"),
+        ]),
+    )
+    .await;
+    let focus = "Check cancellation safety. Vérifier les erreurs.\n\n".repeat(40);
+    test.cmd_with_server(&server)
+        .args(["-m", "gpt-5.1", "review", "--range"])
+        .arg(format!("{base}..HEAD"))
+        .arg("-")
+        .write_stdin(focus.clone())
+        .assert()
+        .success();
+
+    let user_messages = mock.single_request().message_input_texts("user");
+    let expected = format!(
+        "Review commit range {base}..{head} (1 commit).\n\nRun `git diff {base} {head}` for combined changes and `git log -p {base}..{head}` for individual commits. Review only this range. Provide prioritized, actionable findings.\n\nAdditional focus: {}",
+        focus.trim()
+    );
+    assert!(
+        user_messages.iter().any(|message| message == &expected),
+        "review request: {user_messages:?}"
+    );
+    assert!(
+        user_messages
+            .iter()
+            .all(|message| !message.contains("unique-review-range-subject"))
+    );
+    assert_eq!(
+        (
+            git(cwd, &["rev-parse", "HEAD"])?,
+            git(cwd, &["status", "--porcelain"])?,
+            std::fs::read_to_string(cwd.join("reviewed.txt"))?
+        ),
+        (head, before, "uncommitted work\n".to_string())
+    );
+    Ok(())
+}
