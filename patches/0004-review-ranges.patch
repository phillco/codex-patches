index 0000000000000000000000000000000000000000..df5a3c8633ae50b65f9f7dd60b37fd562d6d4f61
--- /dev/null
+++ b/codex-rs/exec/src/review_range.rs
@@ -0,0 +1,197 @@
+//! Commit-range targets for `codex review`: `--range A..B` (git) and `--rev REVSET` (jj).
+//!
+//! Both resolve to a concrete `base..head` pair of git commits and become a custom review
+//! target whose instructions point the reviewer at exactly those commits.
+
+use std::collections::HashSet;
+use std::path::Path;
+use std::process::Command;
+
+use anyhow::Context;
+
+/// Lets git run inside jj-colocated repos, whose agent git shim otherwise blocks it.
+pub(crate) const JJ_GIT_OK_ENV: &str = "JJ_GIT_OK";
+
+/// A resolved range of commits: `base` (exclusive) to `head` (inclusive).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct CommitRange {
+    pub base: String,
+    pub head: String,
+    /// Full commit IDs, oldest first.
+    pub commits: Vec<String>,
+}
+
+/// Splits `A..B` into its endpoints. Symmetric differences (`A...B`) and open ends are rejected.
+pub(crate) fn parse_range_spec(spec: &str) -> anyhow::Result<(String, String)> {
+    if spec.contains("...") {
+        anyhow::bail!("--range takes A..B (two dots); A...B is not supported");
+    }
+    let Some((base, head)) = spec.split_once("..") else {
+        anyhow::bail!("--range must look like BASE..HEAD, got '{spec}'");
+    };
+    let (base, head) = (base.trim(), head.trim());
+    if base.is_empty() || head.is_empty() {
+        anyhow::bail!("--range needs both ends (BASE..HEAD), got '{spec}'");
+    }
+    Ok((base.to_string(), head.to_string()))
+}
+
+/// Resolves and validates `base..head` with git in `cwd`.
+pub(crate) fn resolve_git_range(cwd: &Path, base: &str, head: &str) -> anyhow::Result<CommitRange> {
+    let base_sha = rev_parse_commit(cwd, base)?;
+    let head_sha = rev_parse_commit(cwd, head)?;
+    run(
+        cwd,
+        "git",
+        &["merge-base", "--is-ancestor", &base_sha, &head_sha],
+    )
+    .context("range base must be an ancestor of its head")?;
+    let log = run(
+        cwd,
+        "git",
+        &[
+            "log",
+            "--reverse",
+            "--format=%H",
+            &format!("{base_sha}..{head_sha}"),
+        ],
+    )?;
+    let commits = log.lines().map(str::to_string).collect::<Vec<_>>();
+    if commits.is_empty() {
+        anyhow::bail!("{base}..{head} contains no commits");
+    }
+    Ok(CommitRange {
+        base: base_sha,
+        head: head_sha,
+        commits,
+    })
+}
+
+/// Resolves a jj revset to a single linear, contiguous run of commits, as git `base..head`.
+pub(crate) fn resolve_jj_revset(cwd: &Path, revset: &str) -> anyhow::Result<CommitRange> {
+    // Resolve once using normal jj snapshot semantics, so `@` includes current
+    // working-copy changes. Later checks use these immutable commit IDs.
+    let log = run(
+        cwd,
+        "jj",
+        &[
+            "--no-pager",
+            "log",
+            "--no-graph",
+            "-r",
+            revset,
+            "-T",
+            "commit_id ++ \" \" ++ parents.map(|p| p.commit_id()).join(\" \") ++ \"\\n\"",
+        ],
+    )?;
+    let rows = log
+        .lines()
+        .map(|line| line.split_whitespace().collect::<Vec<_>>())
+        .collect::<Vec<_>>();
+    if rows.is_empty() {
+        anyhow::bail!("jj revset selects no commits");
+    }
+    if rows.iter().any(|row| row.len() != 2) {
+        anyhow::bail!("jj revset must be linear: every selected commit needs exactly one parent");
+    }
+    let selected = rows.iter().map(|row| row[0]).collect::<HashSet<_>>();
+    let parents = rows.iter().map(|row| row[1]).collect::<HashSet<_>>();
+    let roots = rows
+        .iter()
+        .filter(|row| !selected.contains(row[1]))
+        .collect::<Vec<_>>();
+    let heads = selected.difference(&parents).copied().collect::<Vec<_>>();
+    let ([root], [head]) = (roots.as_slice(), heads.as_slice()) else {
+        anyhow::bail!("jj revset must select one contiguous, linear run of commits");
+    };
+    let range = resolve_git_range(cwd, root[1], head)
+        .context("resolving the jj revset with git (is this jj repo colocated with git?)")?;
+    let git_selected = range
+        .commits
+        .iter()
+        .map(String::as_str)
+        .collect::<HashSet<_>>();
+    if selected != git_selected {
+        anyhow::bail!("jj revset does not match its resolved Git commit range");
+    }
+    Ok(range)
+}
+
+/// Review instructions for a range, in the style of the built-in commit prompt.
+pub(crate) fn range_review_instructions(range: &CommitRange, focus: Option<&str>) -> String {
+    let CommitRange {
+        base,
+        head,
+        commits,
+    } = range;
+    let count = commits.len();
+    let noun = if count == 1 { "commit" } else { "commits" };
+    let mut instructions = format!(
+        "Review commit range {base}..{head} ({count} {noun}).\n\nRun `git diff {base} {head}` for combined changes and `git log -p {base}..{head}` for individual commits. Review only this range. Provide prioritized, actionable findings."
+    );
+    if let Some(focus) = focus.map(str::trim).filter(|focus| !focus.is_empty()) {
+        instructions.push_str(&format!("\n\nAdditional focus: {focus}"));
+    }
+    instructions
+}
+
+/// A short label for the review summary, e.g. `3 commits 1a2b3c4..5d6e7f8`.
+pub(crate) fn range_hint(range: &CommitRange) -> String {
+    let count = range.commits.len();
+    let noun = if count == 1 { "commit" } else { "commits" };
+    format!(
+        "{count} {noun} {}..{}",
+        short(&range.base),
+        short(&range.head)
+    )
+}
+
+/// Whether `dir` is inside a jj repository.
+pub(crate) fn is_jj_repo(dir: &Path) -> bool {
+    dir.ancestors()
+        .any(|ancestor| ancestor.join(".jj").is_dir())
+}
+
+fn short(sha: &str) -> &str {
+    sha.get(..10).unwrap_or(sha)
+}
+
+fn rev_parse_commit(cwd: &Path, rev: &str) -> anyhow::Result<String> {
+    let out = run(
+        cwd,
+        "git",
+        &[
+            "rev-parse",
+            "--verify",
+            "--quiet",
+            "--end-of-options",
+            &format!("{rev}^{{commit}}"),
+        ],
+    )
+    .with_context(|| format!("unknown commit '{rev}'"))?;
+    Ok(out.trim().to_string())
+}
+
+fn run(cwd: &Path, program: &str, args: &[&str]) -> anyhow::Result<String> {
+    let mut command = Command::new(program);
+    if program == "git" {
+        command.args(["--no-pager", "-c", "color.ui=false"]);
+    } else if program == "jj" {
+        command.args(["--color", "never"]);
+    }
+    let output = command
+        .args(args)
+        .current_dir(cwd)
+        .env(JJ_GIT_OK_ENV, "1")
+        .output()
+        .with_context(|| format!("failed to run {program} (is it installed?)"))?;
+    if !output.status.success() {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        anyhow::bail!("{program} {} failed: {}", args.join(" "), stderr.trim());
+    }
+    Ok(String::from_utf8_lossy(&output.stdout).into_owned())
+}
+
