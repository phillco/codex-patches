@@ -0,0 +1,175 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn enter_before_turn_started_preserves_steers_and_tab_queue() {
+    let (mut chat, mut rx, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.bottom_pane
+        .set_composer_text("initial prompt".into(), Vec::new(), Vec::new());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert_matches!(next_submit_op(&mut ops), Op::UserTurn { .. });
+    assert!(!chat.bottom_pane.is_task_running());
+    let _ = drain_insert_history(&mut rx);
+
+    for (text, key) in [
+        ("first steer", KeyCode::Enter),
+        ("next turn", KeyCode::Tab),
+        ("second steer", KeyCode::Enter),
+    ] {
+        chat.bottom_pane
+            .set_composer_text(text.into(), Vec::new(), Vec::new());
+        chat.handle_key_event(KeyEvent::from(key));
+    }
+
+    for text in ["first steer", "second steer"] {
+        assert_matches!(next_submit_op(&mut ops), Op::UserTurn { items, .. } if items == vec![
+            UserInput::Text {
+                text: text.into(),
+                text_elements: Vec::new(),
+            }
+        ]);
+    }
+    assert_eq!(chat.queued_user_message_texts(), vec!["next turn"]);
+    assert!(drain_insert_history(&mut rx).is_empty());
+    chat.bottom_pane
+        .set_composer_text("unsent draft".into(), Vec::new(), Vec::new());
+    assert_chatwidget_snapshot!(
+        "enter_before_turn_started_preserves_steers_and_tab_queue",
+        render_bottom_popup(&chat, /*width*/ 80)
+    );
+    chat.bottom_pane
+        .set_composer_text(String::new(), Vec::new(), Vec::new());
+
+    handle_turn_started(&mut chat, "turn-1");
+    assert_no_submit_op(&mut ops);
+    assert_eq!(chat.queued_user_message_texts(), vec!["next turn"]);
+    complete_user_message(&mut chat, "steer-1", "first steer");
+    complete_user_message(&mut chat, "steer-2", "second steer");
+    assert!(chat.input_queue.pending_steers.is_empty());
+    handle_turn_completed(&mut chat, "turn-1", /*duration_ms*/ None);
+    assert_matches!(next_submit_op(&mut ops), Op::UserTurn { items, .. } if items == vec![
+        UserInput::Text {
+            text: "next turn".into(),
+            text_elements: Vec::new(),
+        }
+    ]);
+}
+
+#[tokio::test]
+async fn pending_special_commands_do_not_inherit_user_turn_steering() {
+    for command in [
+        Op::compact(),
+        Op::review(ReviewTarget::UncommittedChanges),
+        Op::run_user_shell_command("echo hello".into()),
+    ] {
+        let (mut chat, _rx, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.thread_id = Some(ThreadId::new());
+        chat.submit_user_message("initial prompt".into());
+        let _ = next_submit_op(&mut ops);
+        assert!(chat.submit_op(command.clone()));
+        assert_eq!(ops.try_recv().expect("pending command"), command);
+        chat.bottom_pane
+            .set_composer_text("follow-up".into(), Vec::new(), Vec::new());
+        chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+
+        assert_eq!(chat.queued_user_message_texts(), vec!["follow-up"]);
+        assert!(chat.input_queue.pending_steers.is_empty());
+        assert_no_submit_op(&mut ops);
+    }
+}
+
+#[tokio::test]
+async fn pending_user_turn_does_not_start_shell_input_early() {
+    let (mut chat, _rx, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.submit_user_message("initial prompt".into());
+    let _ = next_submit_op(&mut ops);
+    chat.bottom_pane
+        .set_composer_text("!echo hello".into(), Vec::new(), Vec::new());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+
+    assert_eq!(chat.queued_user_message_texts(), vec!["!echo hello"]);
+    assert!(chat.input_queue.pending_steers.is_empty());
+    assert_no_submit_op(&mut ops);
+}
+
+#[tokio::test]
+async fn pending_user_turn_keeps_settings_and_recovery_submission_guards() {
+    for recovering in [false, true] {
+        let (mut chat, _rx, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.thread_id = Some(ThreadId::new());
+        chat.submit_user_message("initial prompt".into());
+        let _ = next_submit_op(&mut ops);
+        chat.input_queue.rate_limit_recovery_pending = recovering;
+        chat.input_queue.suppress_queue_autosend = !recovering;
+        chat.bottom_pane
+            .set_composer_text("follow-up".into(), Vec::new(), Vec::new());
+        chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+
+        assert_eq!(chat.queued_user_message_texts(), vec!["follow-up"]);
+        assert!(chat.input_queue.pending_steers.is_empty());
+        assert_no_submit_op(&mut ops);
+    }
+}
+
+#[tokio::test]
+async fn pending_user_turn_steering_survives_in_flight_thread_restore() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    chat.submit_user_message("initial prompt".into());
+    let input = chat.capture_thread_input_state();
+
+    let (mut restored, mut rx, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    restored.thread_id = Some(thread_id);
+    restored.restore_thread_input_state(
+        input,
+        ThreadInputStateRestoreMode {
+            preserve_in_flight_turn: true,
+        },
+    );
+    let _ = drain_insert_history(&mut rx);
+    restored.bottom_pane.set_composer_text(
+        "steer after switching back".into(),
+        Vec::new(),
+        Vec::new(),
+    );
+    restored.handle_key_event(KeyEvent::from(KeyCode::Enter));
+
+    assert_matches!(next_submit_op(&mut ops), Op::UserTurn { items, .. } if items == vec![
+        UserInput::Text {
+            text: "steer after switching back".into(),
+            text_elements: Vec::new(),
+        }
+    ]);
+    assert!(restored.input_queue.queued_user_messages.is_empty());
+    assert_eq!(restored.input_queue.pending_steers.len(), 1);
+    assert!(drain_insert_history(&mut rx).is_empty());
+}
+
+#[tokio::test]
+async fn pending_safety_retry_accepts_enter_as_steer() {
+    let (mut chat, _rx, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.prepare_safety_buffered_retry_submission("retry prompt".into());
+    chat.bottom_pane
+        .set_composer_text("steer retry".into(), Vec::new(), Vec::new());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+
+    assert_matches!(next_submit_op(&mut ops), Op::UserTurn { .. });
+    assert_eq!(chat.input_queue.pending_steers.len(), 1);
+    assert!(chat.input_queue.queued_user_messages.is_empty());
+}
+
+#[tokio::test]
+async fn startup_enter_still_waits_for_session_configuration() {
+    let (mut chat, _rx, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.bottom_pane
+        .set_composer_text("startup prompt".into(), Vec::new(), Vec::new());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+
+    assert_eq!(chat.queued_user_message_texts(), vec!["startup prompt"]);
+    assert!(chat.input_queue.pending_steers.is_empty());
+    assert_no_submit_op(&mut ops);
+}
