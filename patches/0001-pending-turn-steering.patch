+    let (mut app, mut events, mut ops) = make_test_app_with_channels().await;
+    let thread_id = ThreadId::new();
+    app.active_thread_id = Some(thread_id);
+    app.primary_thread_id = Some(thread_id);
+    app.chat_widget
+        .handle_thread_session(test_thread_session(thread_id, app.config.cwd.to_path_buf()));
+    let listener = TcpListener::bind("127.0.0.1:0").await?;
+    let endpoint = crate::resolve_remote_addr(&format!("ws://{}", listener.local_addr()?))?;
+    app.app_server_target = AppServerTarget::Remote {
+        endpoint: endpoint.clone(),
+    };
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await?;
+        serve_reconnect_requests(tokio_tungstenite::accept_async(stream).await?, |request| {
+            // Deliberately emit no TurnStarted notification before the next user submission.
+            std::future::ready(Some(match request.method.as_str() {
+                "turn/start" => json!({"result": {
+                    "turn": test_turn("early-turn", TurnStatus::InProgress, Vec::new())
+                }}),
+                "turn/steer" => {
+                    let params = request.params.expect("steer params");
+                    assert_eq!(params["expectedTurnId"], json!("early-turn"));
+                    assert_eq!(
+                        params["input"],
+                        json!([{
+                            "type": "text", "text": "early steer", "text_elements": []
+                        }])
+                    );
+                    json!({"result": {"turnId": "early-turn"}})
+                }
+                method => panic!("unexpected request: {method}"),
+            }))
+        })
+        .await
+    });
+    let mut session = AppServerSession::new(
+        crate::connect_remote_app_server(endpoint).await?,
+        ThreadParamsMode::Remote,
+    );
+
+    app.chat_widget
+        .apply_external_edit("original request".into());
+    app.chat_widget
+        .handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let original = next_user_turn_op(&mut ops);
+    app.submit_thread_op(&mut session, thread_id, original.clone())
+        .await?;
+    assert_eq!(
+        app.active_turn_id_for_thread(thread_id).await,
+        Some("early-turn".into())
+    );
+    app.chat_widget.apply_external_edit("early steer".into());
+    app.chat_widget
+        .handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let steer = next_user_turn_op(&mut ops);
+    app.submit_thread_op(&mut session, thread_id, steer).await?;
+
+    // Once the delayed start arrives, retry must still refer to the original request.
+    app.chat_widget.handle_server_notification(
+        turn_started_notification(thread_id, "early-turn"),
+        /*replay_kind*/ None,
+    );
+    app.chat_widget.handle_server_notification(
+        ServerNotification::ModelSafetyBufferingUpdated(ModelSafetyBufferingUpdatedNotification {
+            thread_id: thread_id.to_string(),
+            turn_id: "early-turn".into(),
+            model: app
+                .config
+                .model
+                .clone()
+                .unwrap_or_else(|| "gpt-test".into()),
+            use_cases: Vec::new(),
+            reasons: Vec::new(),
+            show_buffering_ui: true,
+            faster_model: Some("gpt-test-fast".into()),
+        }),
+        /*replay_kind*/ None,
+    );
+    app.chat_widget
+        .handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let retry = std::iter::from_fn(|| events.try_recv().ok())
+        .find_map(|event| match event {
+            AppEvent::ConfirmSafetyBufferedRetry { turn, prompt, .. } => Some((turn, prompt)),
+            _ => None,
+        })
+        .expect("retry confirmation for the original request");
+    assert_eq!(retry, (original, UserMessage::from("original request")));
+
+    session.shutdown().await?;
+    assert_eq!(
+        server.await??,
+        vec!["initialize", "turn/start", "turn/steer"]
+    );
+    Ok(())
+}
 
