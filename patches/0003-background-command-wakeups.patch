@@ -0,0 +1,83 @@
+//! Pending command completions consumed by an active `clock.sleep` call.
+//!
+//! Readiness stays with the stored process, so collecting its final result or
+//! removing it also discards the notification. No turn is started on completion.
+
+use std::fmt;
+use std::sync::Arc;
+use std::sync::atomic::Ordering;
+
+use super::UnifiedExecProcess;
+use super::UnifiedExecProcessManager;
+
+pub(crate) struct BackgroundCommandCompletion {
+    process_id: i32,
+    status: CompletionStatus,
+}
+
+enum CompletionStatus {
+    Exited(i32),
+    Failed,
+    TimedOut,
+}
+
+impl fmt::Display for BackgroundCommandCompletion {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let process_id = self.process_id;
+        match self.status {
+            CompletionStatus::Exited(exit_code) => {
+                write!(
+                    formatter,
+                    "Session {process_id} exited with code {exit_code}."
+                )
+            }
+            CompletionStatus::Failed => write!(formatter, "Session {process_id} failed."),
+            CompletionStatus::TimedOut => write!(formatter, "Session {process_id} timed out."),
+        }
+    }
+}
+
+impl UnifiedExecProcessManager {
+    pub(super) async fn record_completion(
+        &self,
+        process_id: i32,
+        process: &Arc<UnifiedExecProcess>,
+    ) {
+        let mut store = self.process_store.lock().await;
+        if let Some(entry) = store.processes.get_mut(&process_id)
+            && Arc::ptr_eq(&entry.process, process)
+        {
+            let status = if process.failure_message().is_some() {
+                CompletionStatus::Failed
+            } else if process.timed_out() {
+                CompletionStatus::TimedOut
+            } else {
+                CompletionStatus::Exited(process.exit_code().unwrap_or(/*default*/ -1))
+            };
+            entry.completion = Some(BackgroundCommandCompletion { process_id, status });
+            self.completion_notify.notify_waiters();
+        }
+    }
+
+    pub(crate) async fn wait_for_completion(&self) -> BackgroundCommandCompletion {
+        loop {
+            // Register before inspecting the store, including when another
+            // sleeper is already waiting. Each completion is claimed once.
+            let notified = self.completion_notify.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            {
+                let mut store = self.process_store.lock().await;
+                for entry in store.processes.values_mut() {
+                    // The initial call may still return this exit inline.
+                    if !entry.initial_exec_command_active.load(Ordering::Acquire)
+                        && let Some(completion) = entry.completion.take()
+                    {
+                        return completion;
+                    }
+                }
+            }
+            notified.await;
+        }
+    }
+}
