+#[test_case::test_case(CompletionReadiness::RemovedBeforeWait; "collected_completion_is_discarded")]
+#[tokio::test]
+async fn background_completion_wakes_waiter_once(readiness: CompletionReadiness) {
+    use std::future::Future;
+    use std::task::Context;
+    use std::task::Wake;
+    use std::task::Waker;
+
+    struct WakeFlag(AtomicBool);
+    impl Wake for WakeFlag {
+        fn wake(self: Arc<Self>) {
+            self.0.store(/*val*/ true, Ordering::Release);
+        }
+    }
+
+    let (_, turn) = crate::session::tests::make_session_and_context().await;
+    let process = Arc::new(
+        crate::unified_exec::process_tests::remote_process(
+            codex_exec_server::WriteStatus::Accepted,
+            /*terminate_error*/ None,
+            codex_sandboxing::SandboxType::None,
+        )
+        .await,
+    );
+    process.terminate_confirmed().await.expect("process exits");
+    let manager = UnifiedExecProcessManager::default();
+    let active = Arc::new(AtomicBool::new(/*v*/ true));
+    let initial_call = InitialExecCommandGuard {
+        active: Some(Arc::clone(&active)),
+        completion_notify: &manager.completion_notify,
+        metrics_sidecar: None,
+    };
+    let process_id = 123;
+    manager.process_store.lock().await.processes.insert(
+        process_id,
+        ProcessEntry {
+            process: Arc::clone(&process),
+            completion: None,
+            plugin_metrics_sidecar: None,
+            call_id: "background-call".to_string(),
+            process_id,
+            cwd: PathUri::parse("file:///tmp").expect("test cwd"),
+            initial_exec_command_active: active,
+            hook_command: "command".to_string(),
+            tty: false,
+            environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.to_string(),
+            permissions: super::super::TerminalPermissions::for_launch(
+                turn.environments.primary().expect("turn environment"),
+                &turn,
+                super::super::TerminalSandboxSource::Native,
+                crate::sandboxing::SandboxPermissions::UseDefault,
+                /*additional_permissions*/ None,
+                /*internal_permissions*/ None,
+            ),
+            network_approval: None,
+            session: std::sync::Weak::new(),
+            last_used: Instant::now(),
+        },
+    );
+
+    let wake = Arc::new(WakeFlag(AtomicBool::new(/*v*/ false)));
+    let waker = Waker::from(Arc::clone(&wake));
+    let mut context = Context::from_waker(&waker);
+    let waiting = manager.wait_for_completion();
+    tokio::pin!(waiting);
+    let next_wait = manager.wait_for_completion();
+    tokio::pin!(next_wait);
+    match readiness {
+        CompletionReadiness::InitialCallActive => {
+            assert!(waiting.as_mut().poll(&mut context).is_pending());
+            assert!(next_wait.as_mut().poll(&mut context).is_pending());
+            manager.record_completion(process_id, &process).await;
+            assert!(waiting.as_mut().poll(&mut context).is_pending());
+            wake.0.store(/*val*/ false, Ordering::Release);
+            drop(initial_call);
+            assert!(wake.0.load(Ordering::Acquire));
+        }
+        CompletionReadiness::BeforeWait | CompletionReadiness::RemovedBeforeWait => {
+            drop(initial_call);
+            manager.record_completion(process_id, &process).await;
+            if matches!(readiness, CompletionReadiness::RemovedBeforeWait) {
+                manager.release_process_id(process_id).await;
+                assert!(waiting.as_mut().poll(&mut context).is_pending());
+                return;
+            }
+        }
+    }
+    let completion = waiting.await;
+    assert_eq!(
+        completion.to_string(),
+        format!("Session {process_id} exited with code -1.")
+    );
+    assert!(next_wait.as_mut().poll(&mut context).is_pending());
+}
