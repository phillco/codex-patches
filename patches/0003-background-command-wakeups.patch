+use core_test_support::responses::start_mock_server;
+use core_test_support::skip_if_no_network;
+use core_test_support::skip_if_sandbox;
+use core_test_support::skip_if_target_windows;
+use core_test_support::test_codex::TestCodex;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use test_case::test_case;
+use tokio::sync::mpsc;
+use tokio::sync::oneshot;
+
+struct ControlledTimeProvider {
+    sleeps: mpsc::UnboundedSender<oneshot::Sender<()>>,
+}
+
+impl TimeProvider for ControlledTimeProvider {
+    fn current_time(&self, _thread_id: ThreadId) -> TimeFuture<'_> {
+        Box::pin(async { Ok(Utc::now()) })
+    }
+
+    fn sleep(&self, _thread_id: ThreadId, _duration: Duration) -> SleepFuture<'_> {
+        Box::pin(async {
+            let (finish, finished) = oneshot::channel();
+            self.sleeps.send(finish)?;
+            finished.await?;
+            Ok(())
+        })
+    }
+}
+
+#[derive(Clone, Copy)]
+enum CompletionTiming {
+    DuringSleep,
+    BeforeSleep,
+    Foreground,
+    Collected,
+}
+
+fn response(event: Value) -> String {
+    sse(vec![
+        ev_response_created("response"),
+        event,
+        ev_completed("response"),
+    ])
+}
+
+async fn release_command(test: &TestCodex) -> Result<()> {
+    test.fs()
+        .write_file(
+            &test.workspace_path_uri("release")?,
+            Vec::new(),
+            Default::default(),
+            /*sandbox*/ None,
+        )
+        .await?;
+    Ok(())
+}
+
+async fn finish_next_sleep(
+    sleeps: &mut mpsc::UnboundedReceiver<oneshot::Sender<()>>,
+) -> Result<()> {
+    tokio::time::timeout(Duration::from_secs(/*secs*/ 5), async {
+        // A sleep interrupted by completion may have already dropped its timer.
+        while let Some(finish) = sleeps.recv().await {
+            if finish.send(()).is_ok() {
+                return;
+            }
+        }
+        panic!("sleep timer channel closed");
+    })
+    .await?;
+    Ok(())
+}
+
+#[test_case(CompletionTiming::DuringSleep; "completion_interrupts_active_sleep")]
+#[test_case(CompletionTiming::BeforeSleep; "pending_completion_is_delivered_once")]
+#[test_case(CompletionTiming::Foreground; "foreground_completion_does_not_interrupt_sleep")]
+#[test_case(CompletionTiming::Collected; "collected_completion_does_not_interrupt_sleep")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn sleep_observes_uncollected_background_completion(timing: CompletionTiming) -> Result<()> {
+    skip_if_target_windows!(Ok(()), "uses a POSIX shell file handshake");
+    skip_if_no_network!(Ok(()));
+    skip_if_sandbox!(Ok(()));
+
+    let server = start_mock_server().await;
+    let (sleeps_tx, mut sleeps_rx) = mpsc::unbounded_channel();
+    let test = test_codex()
+        .with_model("gpt-5.4")
+        .with_config(|config| {
+            config
+                .features
+                .enable(Feature::CurrentTimeReminder)
+                .expect("enable clock tools");
+            config.current_time_reminder = Some(CurrentTimeReminderConfig {
+                clock_source: CurrentTimeSource::External,
+                sleep_tool: true,
+                ..Default::default()
+            });
+        })
+        .with_external_time_provider(Arc::new(ControlledTimeProvider { sleeps: sleeps_tx }))
+        .build_with_auto_env(&server)
+        .await?;
+
+    let command = match timing {
+        CompletionTiming::Foreground => "printf 'retained-output\\n'; exit 7",
+        CompletionTiming::DuringSleep
+        | CompletionTiming::BeforeSleep
+        | CompletionTiming::Collected => {
+            "while [ ! -f release ]; do sleep 0.01; done; printf 'retained-output\\n'; exit 7"
+        }
+    };
+    let done = response(ev_assistant_message("done", "done"));
+    let poll = response(ev_function_call(
+        "poll",
+        "write_stdin",
+        &json!({ "session_id": 1000, "chars": "", "yield_time_ms": 1000 }).to_string(),
+    ));
+    let mut responses = vec![
+        response(ev_function_call(
+            "exec",
+            "exec_command",
+            &json!({ "cmd": command, "shell": "/bin/sh", "login": false, "yield_time_ms": 1000 })
+                .to_string(),
+        )),
+        done.clone(),
+    ];
+    if matches!(timing, CompletionTiming::Collected) {
+        responses.extend([poll.clone(), done.clone()]);
+    }
+    for call_id in ["sleep-first", "sleep-second"] {
+        responses.extend([
+            response(ev_function_call_with_namespace(
+                call_id,
+                "clock",
+                "sleep",
+                &json!({ "duration_ms": 3_600_000 }).to_string(),
+            )),
+            done.clone(),
+        ]);
+    }
+    if matches!(
+        timing,
+        CompletionTiming::DuringSleep | CompletionTiming::BeforeSleep
+    ) {
+        responses.extend([poll, done]);
+    }
+    let requests = mount_sse_sequence(&server, responses).await;
+    test.submit_turn("start the command").await?;
+    let first_output = requests.requests()[1]
+        .function_call_output_text("exec")
+        .expect("exec output");
+    assert_eq!(
+        first_output.contains("Process running with session ID 1000"),
+        !matches!(timing, CompletionTiming::Foreground)
+    );
+
+    match timing {
+        CompletionTiming::DuringSleep => {
+            let (_, timer) = tokio::try_join!(
+                test.submit_turn("sleep until the command completes"),
+                async {
+                    let timer =
+                        tokio::time::timeout(Duration::from_secs(/*secs*/ 5), sleeps_rx.recv())
+                            .await?
+                            .expect("sleep started");
+                    release_command(&test).await?;
+                    Ok::<_, anyhow::Error>(timer)
+                }
+            )?;
+            drop(timer);
+        }
+        CompletionTiming::BeforeSleep | CompletionTiming::Collected => {
+            release_command(&test).await?;
+            wait_for_event(&test.codex, |event| {
+                matches!(event, EventMsg::ItemCompleted(event)
+                    if matches!(&event.item, TurnItem::CommandExecution(item) if item.id == "exec"))
+            })
+            .await;
+            if matches!(timing, CompletionTiming::Collected) {
+                test.submit_turn("collect the command output").await?;
+                tokio::try_join!(
+                    test.submit_turn("sleep normally"),
+                    finish_next_sleep(&mut sleeps_rx)
+                )?;
+            } else {
+                test.submit_turn("observe the already completed command")
+                    .await?;
+            }
+        }
+        CompletionTiming::Foreground => {
+            tokio::try_join!(
+                test.submit_turn("sleep normally"),
+                finish_next_sleep(&mut sleeps_rx)
+            )?;
+        }
+    }
+    tokio::try_join!(
+        test.submit_turn("sleep a second time"),
+        finish_next_sleep(&mut sleeps_rx)
+    )?;
+    if matches!(
+        timing,
+        CompletionTiming::DuringSleep | CompletionTiming::BeforeSleep
+    ) {
+        test.submit_turn("collect the retained command output")
+            .await?;
+    }
+
+    let recorded = requests.requests();
+    let output = |call_id| {
+        recorded
+            .iter()
+            .find_map(|request| request.function_call_output_text(call_id))
+            .expect("tool output recorded")
+    };
+    let first_sleep = output("sleep-first");
+    let first_message = first_sleep.split_once(" seconds\n").expect("wall time").1;
+    assert_eq!(
+        first_message,
+        match timing {
+            CompletionTiming::DuringSleep | CompletionTiming::BeforeSleep => {
+                "Sleep interrupted by background command completion.\nSession 1000 exited with code 7."
+            }
+            CompletionTiming::Foreground | CompletionTiming::Collected => "Sleep completed.",
+        }
+    );
+    assert_eq!(
+        output("sleep-second")
+            .split_once(" seconds\n")
+            .expect("wall time")
+            .1,
+        "Sleep completed."
+    );
+    if !matches!(timing, CompletionTiming::Foreground) {
+        assert!(output("poll").contains("Process exited with code 7\n"));
+        assert!(output("poll").ends_with("Output:\nretained-output\n"));
+    }
+    Ok(())
+}
