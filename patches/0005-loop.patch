@@ -0,0 +1,44 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[test]
+fn only_explicit_registration_rejections_allow_plain_attach_retry() {
+    for (code, data, expected) in [
+        (
+            JSONRPC_INVALID_REQUEST,
+            Some(json!({"dynamicToolRegistrationRejected":true})),
+            true,
+        ),
+        (
+            JSONRPC_INVALID_PARAMS,
+            Some(json!({"dynamicToolRegistrationRejected":true})),
+            true,
+        ),
+        (JSONRPC_INVALID_REQUEST, None, false),
+        (
+            JSONRPC_INVALID_REQUEST,
+            Some(json!({"dynamicToolRegistrationRejected":false})),
+            false,
+        ),
+        (
+            JSONRPC_INVALID_REQUEST,
+            Some(json!({"dynamicToolRegistrationRejected":"true"})),
+            false,
+        ),
+        (
+            -32603,
+            Some(json!({"dynamicToolRegistrationRejected":true})),
+            false,
+        ),
+    ] {
+        assert_eq!(
+            is_loop_registration_rejected(&JSONRPCErrorError {
+                code,
+                data,
+                message: "unrelated text must not control retry behavior".to_string(),
+            }),
+            expected
+        );
+    }
+}
