+//! Only locally initiated, completed automatic turns may collapse their presentation.
+use super::*;
+
+pub(super) struct QuietLoopRun {
+    thread_id: ThreadId,
+    run_id: String,
+    start: usize,
+    expected_users: usize,
+    anchor: Arc<dyn HistoryCell>,
+}
+
+impl App {
+    pub(super) fn begin_quiet_loop(
+        &mut self,
+        thread_id: ThreadId,
+        run_id: String,
+        expected_users: usize,
+    ) {
+        if self.chat_widget.thread_id() != Some(thread_id) {
+            return;
+        }
+        if let Some(old) = self.quiet_loop_run.take()
+            && self
+                .transcript_cells
+                .get(old.start)
+                .is_some_and(|cell| Arc::ptr_eq(cell, &old.anchor))
+        {
+            self.transcript_cells.remove(old.start);
+        }
+        // An invisible identity anchor fails open if pagination/backtrack changes the range.
+        let anchor: Arc<dyn HistoryCell> =
+            Arc::new(history_cell::PlainHistoryCell::new(Vec::new()));
+        self.quiet_loop_run = Some(QuietLoopRun {
+            thread_id,
+            run_id,
+            start: self.transcript_cells.len(),
+            expected_users,
+            anchor: anchor.clone(),
+        });
+        self.transcript_cells.push(anchor);
+    }
+    pub(super) fn finish_quiet_loop(
+        &mut self,
+        tui: &mut tui::Tui,
+        thread_id: ThreadId,
+        run_id: String,
+        summary: Option<String>,
+    ) -> Result<()> {
+        let Some(run) = self.quiet_loop_run.as_ref() else {
+            return Ok(());
+        };
+        if run.thread_id != thread_id
+            || run.run_id != run_id
+            || self.chat_widget.thread_id() != Some(thread_id)
+            || !self
+                .transcript_cells
+                .get(run.start)
+                .is_some_and(|cell| Arc::ptr_eq(cell, &run.anchor))
+        {
+            return Ok(());
+        }
+        let run = self.quiet_loop_run.take().expect("matching loop run");
+        self.transcript_cells.remove(run.start);
+        let Some(summary) = summary else {
+            return Ok(());
+        };
+        if self.transcript_cells.len().saturating_sub(run.start) > 64 {
+            return Ok(());
+        }
+        let Some(cell) = history_cell::QuietLoopCell::bounded(
+            summary,
+            self.transcript_cells[run.start..].to_vec(),
+            run.expected_users,
+        ) else {
+            return Ok(());
+        };
+        self.transcript_cells
+            .splice(run.start.., [Arc::new(cell) as Arc<dyn HistoryCell>]);
+        if let Some(Overlay::Transcript(overlay)) = &mut self.overlay {
+            overlay.replace_cells(self.transcript_cells.clone());
+        }
+        self.finish_required_stream_reflow(tui)
+    }
+}
