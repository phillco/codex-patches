+#[tokio::test]
+async fn prompt_loop_waits_for_idle_and_never_catches_up() {
+    let (mut chat, _rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.handle_prompt_loop_command("5m check the build");
+    let now = Instant::now();
+    chat.turn_lifecycle.agent_turn_running = true;
+    chat.tick_prompt_loop(now + Duration::from_secs(/*secs*/ 900));
+    assert_no_submit_op(&mut op_rx);
+    chat.turn_lifecycle.agent_turn_running = false;
+    chat.tick_prompt_loop(now + Duration::from_secs(/*secs*/ 900));
+    let Op::UserTurn { items, .. } = next_submit_op(&mut op_rx) else {
+        panic!("expected user turn");
+    };
+    assert_eq!(
+        items,
+        vec![UserInput::Text {
+            text: "check the build".to_string(),
+            text_elements: vec![]
+        }]
+    );
+    // Even if turn-start hasn't arrived, another draw must not start a duplicate.
+    chat.tick_prompt_loop(now + Duration::from_secs(/*secs*/ 900));
+    assert_no_submit_op(&mut op_rx);
