+++ b/codex-rs/tui/src/history_cell/quiet_loop_tests.rs
@@ -0,0 +1,145 @@
+use super::*;
+use insta::assert_snapshot;
+use pretty_assertions::assert_eq;
+
+fn plain(text: &str) -> Arc<dyn HistoryCell> {
+    Arc::new(PlainHistoryCell::new(vec![text.to_string().into()]))
+}
+fn text(lines: Vec<Line<'static>>) -> String {
+    lines
+        .iter()
+        .map(|line| {
+            line.spans
+                .iter()
+                .map(|span| span.content.as_ref())
+                .collect::<String>()
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+#[test]
+fn quiet_loop_keeps_full_transcript_while_inline_stays_compact_after_resize() {
+    let cell = QuietLoopCell::bounded(
+        "Next loop in 5m · CI still running".into(),
+        vec![plain("Checked CI"), plain("Still running")],
+        /*expected_users*/ 0,
+    )
+    .unwrap();
+    assert_snapshot!(text(cell.display_lines(/*width*/ 80)), @"Next loop in 5m · CI still running");
+    assert_snapshot!(text(cell.display_lines(/*width*/ 20)), @"Next loop in 5m · CI");
+    assert_eq!(
+        text(cell.transcript_lines(/*width*/ 80)),
+        "Checked CI\nStill running"
+    );
+    assert_eq!(
+        text(cell.transcript_lines(/*width*/ 20)),
+        "Checked CI\nStill running"
+    );
+}
+
+#[test]
+fn quiet_loop_rejects_caps_controls_and_manual_user_interleaving() {
+    let summary = "Next loop in 5m · unchanged";
+    assert!(
+        QuietLoopCell::bounded(
+            summary.into(),
+            vec![plain("x"); 65],
+            /*expected_users*/ 0
+        )
+        .is_none()
+    );
+    assert!(
+        QuietLoopCell::bounded(
+            summary.into(),
+            vec![plain(&"x".repeat(/*n*/ 65_537))],
+            /*expected_users*/ 0
+        )
+        .is_none()
+    );
+    assert!(
+        QuietLoopCell::bounded("bad\nsummary".into(), Vec::new(), /*expected_users*/ 0).is_none()
+    );
+    let user: Arc<dyn HistoryCell> = Arc::new(new_user_prompt(
+        "manual input".into(),
+        Vec::new(),
+        Vec::new(),
+        Vec::new(),
+    ));
+    assert!(
+        QuietLoopCell::bounded(
+            summary.into(),
+            vec![user.clone()],
+            /*expected_users*/ 0
+        )
+        .is_none()
+    );
+    assert!(
+        QuietLoopCell::bounded(
+            summary.into(),
+            vec![user.clone(), user],
+            /*expected_users*/ 1
+        )
+        .is_none()
+    );
+}
+
+#[test]
+fn quiet_loop_first_run_keeps_original_task_visible() {
+    let task: Arc<dyn HistoryCell> = Arc::new(new_user_prompt(
+        "check CI".into(),
+        Vec::new(),
+        Vec::new(),
+        Vec::new(),
+    ));
+    let cell = QuietLoopCell::bounded(
+        "Next loop in 5m · unchanged".into(),
+        vec![task, plain("No change")],
+        /*expected_users*/ 1,
+    )
+    .unwrap();
+    let inline = text(cell.display_lines(/*width*/ 80));
+    assert!(inline.contains("check CI"));
+    assert!(inline.contains("Next loop in 5m"));
+    assert!(!inline.contains("No change"));
+    assert!(text(cell.transcript_lines(/*width*/ 80)).contains("No change"));
+}
+
+#[test]
+fn quiet_loop_keeps_manual_and_incomplete_exec_activity_expanded() {
+    use crate::exec_cell::ExecCall;
+    use crate::exec_cell::ExecCell;
+    use codex_app_server_protocol::CommandExecutionSource;
+    for (source, output) in [
+        (
+            CommandExecutionSource::UserShell,
+            Some(crate::exec_cell::CommandOutput::new(
+                /*exit_code*/ 0,
+                "manual output".into(),
+            )),
+        ),
+        (CommandExecutionSource::Agent, None),
+    ] {
+        let cell: Arc<dyn HistoryCell> = Arc::new(ExecCell::new(
+            ExecCall {
+                call_id: "call".into(),
+                command: vec!["echo".into()],
+                parsed: Vec::new(),
+                output,
+                source,
+                start_time: None,
+                duration: Some(Duration::ZERO),
+                interaction_input: None,
+            },
+            /*animations_enabled*/ false,
+        ));
+        assert!(
+            QuietLoopCell::bounded(
+                "Next loop in 5m · unchanged".into(),
+                vec![cell],
+                /*expected_users*/ 0
+            )
+            .is_none()
+        );
+    }
+}
