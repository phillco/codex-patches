@@ -0,0 +1,66 @@
+//! Client-local scheduling control for a user-started self-paced loop.
+use codex_app_server_protocol::DynamicToolCallOutputContentItem;
+use codex_app_server_protocol::DynamicToolCallResponse;
+use codex_app_server_protocol::DynamicToolFunctionSpec;
+use codex_app_server_protocol::DynamicToolSpec;
+use serde::Deserialize;
+use serde_json::json;
+
+pub(crate) const TOOL_NAME: &str = "schedule_loop";
+
+#[derive(Deserialize)]
+#[serde(tag = "action", rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) enum LoopAction {
+    Schedule {
+        #[serde(rename = "loopId")]
+        loop_id: String,
+        #[serde(rename = "delaySeconds")]
+        delay_seconds: u64,
+        reason: String,
+        #[serde(default)]
+        quiet: bool,
+    },
+    Report {
+        #[serde(rename = "loopId")]
+        loop_id: String,
+        reason: String,
+        #[serde(default)]
+        quiet: bool,
+    },
+    Stop {
+        #[serde(rename = "loopId")]
+        loop_id: String,
+    },
+}
+
+pub(crate) fn tool_spec() -> DynamicToolSpec {
+    DynamicToolSpec::Function(DynamicToolFunctionSpec {
+        name: TOOL_NAME.to_string(),
+        description: "Control a user-started /loop in this terminal session. For fixed loops, report each check with action report and a concise reason; this preserves cadence. Set quiet=true only when nothing meaningful changed. After each self-paced run, schedule the next run in 60–3600 seconds with a concise reason, or stop when the task is done. Use the loopId supplied with the prompt. Cannot create loops. Scheduling never interrupts a busy turn. End your current turn after scheduling.".to_string(),
+        input_schema: json!({
+            "type": "object",
+            "properties": {
+                "action": {"type": "string", "enum": ["schedule", "report", "stop"]},
+                "loopId": {"type": "string"},
+                "delaySeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
+                "quiet": {"type": "boolean", "description": "True only if nothing meaningful changed; collapse this check in terminal history."},
+                "reason": {"type": "string", "minLength": 1, "maxLength": 200}
+            },
+            "required": ["action", "loopId"],
+            "additionalProperties": false
+        }),
+        defer_loading: false,
+    })
+}
+
+pub(crate) fn response(result: Result<String, String>) -> DynamicToolCallResponse {
+    let success = result.is_ok();
+    DynamicToolCallResponse {
+        content_items: vec![DynamicToolCallOutputContentItem::InputText {
+            text: match result {
+                Ok(text) | Err(text) => text,
+            },
+        }],
+        success,
+    }
+}
