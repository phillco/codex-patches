index 0000000000..718a39f7e1
--- /dev/null
+++ b/codex-rs/tui/src/history_cell/quiet_loop.rs
@@ -0,0 +1,122 @@
+//! Compact automatic checks retain their complete transcript for Ctrl+T.
+use super::*;
+use std::sync::Arc;
+
+#[derive(Debug)]
+pub(crate) struct QuietLoopCell {
+    summary: String,
+    children: Vec<Arc<dyn HistoryCell>>,
+    first_prompt: Option<Arc<dyn HistoryCell>>,
+}
+
+impl QuietLoopCell {
+    pub(crate) fn bounded(
+        summary: String,
+        children: Vec<Arc<dyn HistoryCell>>,
+        expected_users: usize,
+    ) -> Option<Self> {
+        if summary.len() > 256
+            || summary.chars().any(char::is_control)
+            || children.len() > 64
+            || children
+                .iter()
+                .filter(|cell| cell.as_any().is::<UserHistoryCell>())
+                .count()
+                != expected_users
+        {
+            return None;
+        }
+        if children.iter().any(|cell| {
+            cell.as_any()
+                .downcast_ref::<crate::exec_cell::ExecCell>()
+                .is_some_and(|exec| {
+                    exec.calls.iter().any(|call| {
+                        call.source == codex_app_server_protocol::CommandExecutionSource::UserShell
+                            || call
+                                .output
+                                .as_ref()
+                                .is_none_or(|output| output.exit_code != 0)
+                    })
+                })
+        }) {
+            return None;
+        }
+        let mut bytes = 0usize;
+        for cell in &children {
+            for line in cell.transcript_lines(u16::MAX) {
+                bytes = bytes.saturating_add(1);
+                if bytes > 65_536 {
+                    return None;
+                }
+                for span in line.spans {
+                    bytes = bytes.saturating_add(span.content.len());
+                    if bytes > 65_536 {
+                        return None;
+                    }
+                }
+            }
+        }
+        let first_prompt = children
+            .iter()
+            .find(|cell| cell.as_any().is::<UserHistoryCell>())
+            .cloned();
+        Some(Self {
+            summary,
+            children,
+            first_prompt,
+        })
+    }
+}
+
+impl HistoryCell for QuietLoopCell {
+    fn display_lines(&self, width: u16) -> Vec<Line<'static>> {
+        let (text, _, _) = crate::live_wrap::take_prefix_by_width(&self.summary, width as usize);
+        let mut lines = self
+            .first_prompt
+            .as_ref()
+            .map(|cell| cell.display_lines(width))
+            .unwrap_or_default();
+        lines.push(Line::from(text).dim());
+        lines
+    }
+    fn raw_lines(&self) -> Vec<Line<'static>> {
+        let mut lines = self
+            .first_prompt
+            .as_ref()
+            .map(|cell| cell.raw_lines())
+            .unwrap_or_default();
+        lines.push(self.summary.clone().into());
+        lines
+    }
+    fn transcript_lines(&self, width: u16) -> Vec<Line<'static>> {
+        self.children
+            .iter()
+            .flat_map(|cell| cell.transcript_lines(width))
+            .collect()
+    }
+    fn transcript_hyperlink_lines(&self, width: u16) -> Vec<HyperlinkLine> {
+        self.children
+            .iter()
+            .flat_map(|cell| cell.transcript_hyperlink_lines(width))
+            .collect()
+    }
+}
+
+#[cfg(test)]
+#[path = "quiet_loop_tests.rs"]
+mod tests;
+
+/// Repeated automatic prompts remain available in Ctrl+T without filling scrollback.
+#[derive(Debug)]
+pub(crate) struct QuietLoopPromptCell(pub(crate) UserHistoryCell);
+impl HistoryCell for QuietLoopPromptCell {
+    fn display_lines(&self, _width: u16) -> Vec<Line<'static>> {
+        Vec::new()
+    }
+    fn raw_lines(&self) -> Vec<Line<'static>> {
+        Vec::new()
+    }
+    fn transcript_lines(&self, width: u16) -> Vec<Line<'static>> {
+        self.0.transcript_lines(width)
+    }
+}
