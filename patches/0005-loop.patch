+        "shell",
+        "mcp",
+        "mcp-status",
+        "patch",
+        "final-guard",
+    ] {
+        let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+        let thread_id = ThreadId::new();
+        chat.thread_id = Some(thread_id);
+        chat.quiet_loop_run = Some(super::super::quiet_loop::QuietLoopRun {
+            id: "run".into(),
+            thread_id,
+            turn_id: Some("loop-turn".into()),
+            client_id: Some("own-submit".into()),
+            prompt: "check CI".into(),
+            summary: Some("Next loop in 5m · unchanged".into()),
+            completed: false,
+            valid: true,
+        });
+        chat.note_stream_consolidation_queued();
+        chat.complete_quiet_loop("loop-turn", /*completed*/ true);
+        assert!(chat.quiet_loop_run.as_ref().unwrap().summary.is_some());
+        match mode {
+            "error" => chat.add_error_message("late failure".into()),
+            "manual" => chat.submit_user_message(UserMessage::from("manual follow-up")),
+            "shell" => chat.submit_user_message(UserMessage::from("!echo manual")),
+            "mcp" | "mcp-status" => {
+                chat.handle_mcp_tool_call_completed_now(ThreadItem::McpToolCall {
+                    id: "failed-call".into(),
+                    server: "test-server".into(),
+                    tool: "check".into(),
+                    status: codex_app_server_protocol::McpToolCallStatus::Failed,
+                    arguments: serde_json::json!({}),
+                    app_context: None,
+                    mcp_app_resource_uri: None,
+                    plugin_id: None,
+                    read_only_hint: None,
+                    result: (mode == "mcp-status").then(|| {
+                        Box::new(codex_app_server_protocol::McpToolCallResult {
+                            content: Vec::new(),
+                            structured_content: None,
+                            meta: None,
+                        })
+                    }),
+                    error: None,
+                    duration_ms: Some(1),
+                })
+            }
+            "patch" => chat.handle_file_change_completed_now(ThreadItem::FileChange {
+                id: "failed-patch".into(),
+                changes: Vec::new(),
+                status: codex_app_server_protocol::PatchApplyStatus::Failed,
+            }),
+            // The emission guard must also reject an already-invalid stale verdict.
+            "final-guard" => chat.quiet_loop_run.as_mut().unwrap().valid = false,
+            _ => unreachable!(),
+        }
+        if mode != "final-guard" {
+            assert!(chat.quiet_loop_run.as_ref().unwrap().summary.is_none());
+        }
+        chat.note_stream_consolidation_completed();
+        let verdict = std::iter::from_fn(|| rx.try_recv().ok()).find_map(|event| match event {
+            AppEvent::FinishQuietLoop { summary, .. } => Some(summary),
+            _ => None,
+        });
+        assert_eq!(verdict, Some(None));
+    }
+}
