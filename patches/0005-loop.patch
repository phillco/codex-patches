diff --git a/codex-rs/tui/src/chatwidget/prompt_loop.rs b/codex-rs/tui/src/chatwidget/prompt_loop.rs
new file mode 100644
index 0000000000..a63d9c732d
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/prompt_loop.rs
@@ -0,0 +1,342 @@
+//! Session-local recurring prompts; never steer an active turn or overwrite a draft.
+use super::*;
+
+const LIFETIME: Duration = Duration::from_secs(/*secs*/ 7 * 24 * 60 * 60);
+const MAX_PROMPT_BYTES: usize = 2_000;
+const USAGE: &str =
+    "Usage: /loop [interval] <prompt> | /loop status | /loop stop (interval: 1m–7d)";
+
+#[derive(Clone, Copy)]
+pub(super) enum Cadence {
+    Fixed(Duration),
+    SelfPaced,
+}
+
+pub(super) struct PromptLoop {
+    thread_id: ThreadId,
+    prompt: String,
+    id: String,
+    cadence: Cadence,
+    due_at: Option<Instant>,
+    expires_at: Instant,
+    showed_prompt: bool,
+}
+
+fn parse_interval(value: &str) -> Option<Duration> {
+    let (number, unit) = value.split_at_checked(value.len().checked_sub(/*rhs*/ 1)?)?;
+    let multiplier = match unit {
+        "s" => 1,
+        "m" => 60,
+        "h" => 3_600,
+        "d" => 86_400,
+        _ => return None,
+    };
+    let seconds = number.parse::<u64>().ok()?.checked_mul(multiplier)?;
+    (60..=LIFETIME.as_secs())
+        .contains(&seconds)
+        .then(|| Duration::from_secs(seconds))
+}
+
+fn format_loop_duration(seconds: u64) -> String {
+    if seconds == 0 {
+        return "0s".to_string();
+    }
+    [
+        (seconds / 86_400, "d"),
+        ((seconds / 3_600) % 24, "h"),
+        ((seconds / 60) % 60, "m"),
+        (seconds % 60, "s"),
+    ]
+    .into_iter()
+    .filter(|(value, _)| *value != 0)
+    .map(|(value, unit)| format!("{value}{unit}"))
+    .collect::<Vec<_>>()
+    .join(" ")
+}
+
+impl ChatWidget {
+    pub(super) fn handle_prompt_loop_command(&mut self, args: &str) {
+        match args.trim() {
+            "stop" | "cancel" => {
+                self.prompt_loop = None;
+                self.add_info_message("Loop stopped.".to_string(), /*hint*/ None);
+                return;
+            }
+            "" | "status" => {
+                let message = match &self.prompt_loop {
+                    Some(state) => format!(
+                        "Loop: {} · {} · {}",
+                        match state.cadence {
+                            Cadence::Fixed(interval) =>
+                                format!("every {}", format_loop_duration(interval.as_secs())),
+                            Cadence::SelfPaced => "self-paced".to_string(),
+                        },
+                        match state.due_at {
+                            Some(due) => format!(
+                                "next in {}",
+                                format_loop_duration(
+                                    due.saturating_duration_since(Instant::now()).as_secs()
+                                )
+                            ),
+                            None => "awaiting next schedule".to_string(),
+                        },
+                        state.prompt
+                    ),
+                    None => "No active loop.".to_string(),
+                };
+                self.add_info_message(message, /*hint*/ None);
+                return;
+            }
+            _ => {}
+        }
+        let (first, rest) = args
+            .trim()
+            .split_once(char::is_whitespace)
+            .unwrap_or((args.trim(), ""));
+        let (cadence, prompt) = match parse_interval(first) {
+            Some(interval) => (Cadence::Fixed(interval), rest),
+            None if first.starts_with(|c: char| c.is_ascii_digit()) => {
+                self.add_error_message(USAGE.to_string());
+                return;
+            }
+            None => (Cadence::SelfPaced, args.trim()),
+        };
+        if matches!(cadence, Cadence::SelfPaced) && !self.loop_tool_available {
+            self.add_error_message("The scheduling tool is unavailable for this conversation. Specify a fixed interval for /loop.".to_string());
+            return;
+        }
+        let prompt = prompt.trim();
+        if prompt.is_empty() || prompt.len() > MAX_PROMPT_BYTES {
+            self.add_error_message(format!(
+                "Loop prompt must contain 1–{MAX_PROMPT_BYTES} UTF-8 bytes."
+            ));
+            return;
+        }
+        let Some(thread_id) = self.thread_id else {
+            self.add_error_message(
+                "Session is still starting; try /loop again in a moment.".to_string(),
+            );
+            return;
+        };
+        let now = Instant::now();
+        let cadence_label = match cadence {
+            Cadence::Fixed(interval) => {
+                format!("every {}", format_loop_duration(interval.as_secs()))
+            }
+            Cadence::SelfPaced => "self-paced".to_string(),
+        };
+        self.prompt_loop = Some(PromptLoop {
+            thread_id,
+            prompt: prompt.to_string(),
+            id: uuid::Uuid::new_v4().to_string(),
+            cadence,
+            due_at: Some(now),
+            expires_at: now + LIFETIME,
+            showed_prompt: false,
+        });
+        self.add_info_message(
+            format!("Loop started · {cadence_label} · expires in 7d"),
+            /*hint*/ None,
+        );
+        self.frame_requester.schedule_frame();
+    }
+
+    pub(crate) fn apply_prompt_loop_action(
+        &mut self,
+        thread_id: &str,
+        turn_id: &str,
+        arguments: serde_json::Value,
+    ) -> Result<String, String> {
+        use crate::prompt_loop_tool::LoopAction;
+        if let Some(run) = &mut self.quiet_loop_run {
+            run.summary = None;
+        }
+        let action: LoopAction =
+            serde_json::from_value(arguments).map_err(|error| error.to_string())?;
+        let state = self.prompt_loop.as_mut().ok_or("No active loop.")?;
+        if state.thread_id.to_string() != thread_id
+            || self.thread_id != Some(state.thread_id)
+            || Instant::now() >= state.expires_at
+        {
+            return Err("This loop is unavailable in the calling thread.".to_string());
+        }
+        let loop_id = match &action {
+            LoopAction::Schedule { loop_id, .. }
+            | LoopAction::Report { loop_id, .. }
+            | LoopAction::Stop { loop_id } => loop_id,
+        };
+        if loop_id != &state.id {
+            return Err("The self-paced loop is no longer active.".to_string());
+        }
+        match action {
+            LoopAction::Report { reason, quiet, .. } => {
+                let Cadence::Fixed(interval) = state.cadence else {
+                    return Err("Self-paced loops must schedule the next check.".to_string());
+                };
+                if reason.trim().is_empty()
+                    || reason.len() > 200
+                    || reason.chars().any(char::is_control)
+                {
+                    return Err("Use a single-line reason of 1–200 bytes.".to_string());
+                }
+                let delay = state
+                    .due_at
+                    .map(|due| due.saturating_duration_since(Instant::now()))
+                    .unwrap_or(interval);
+                let seconds = delay.as_secs() + u64::from(delay.subsec_nanos() > 0);
+                let summary = format!("Next loop in {} · {reason}", format_loop_duration(seconds));
+                self.record_quiet_loop_report(turn_id, summary.clone(), quiet);
+                self.add_info_message(summary, /*hint*/ None);
+                Ok("Check reported; fixed cadence unchanged.".to_string())
+            }
+            LoopAction::Stop { .. } => {
+                self.prompt_loop = None;
+                self.add_info_message("Loop completed.".to_string(), /*hint*/ None);
+                Ok("Loop stopped.".to_string())
+            }
+            LoopAction::Schedule {
+                delay_seconds,
+                reason,
+                quiet,
+                ..
+            } => {
+                if !matches!(state.cadence, Cadence::SelfPaced) {
+                    return Err("Fixed loops use report to preserve their cadence.".to_string());
+                }
+                if !(60..=3600).contains(&delay_seconds)
+                    || reason.trim().is_empty()
+                    || reason.len() > 200
+                    || reason.chars().any(char::is_control)
+                {
+                    return Err(
+                        "Use a delay of 60–3600 seconds and a reason of 1–200 bytes.".to_string(),
+                    );
+                }
+                state.due_at = Some(Instant::now() + Duration::from_secs(delay_seconds));
+                let summary = format!(
+                    "Next loop in {} · {reason}",
+                    format_loop_duration(delay_seconds)
+                );
+                self.record_quiet_loop_report(turn_id, summary.clone(), quiet);
+                self.add_info_message(summary, /*hint*/ None);
+                self.frame_requester
+                    .schedule_frame_in(Duration::from_secs(delay_seconds));
+                Ok("Next run scheduled; end this turn now.".to_string())
+            }
+        }
+    }
+
+    pub(crate) fn tick_prompt_loop(&mut self, now: Instant) {
+        let Some(state) = &self.prompt_loop else {
+            return;
+        };
+        if self.thread_id != Some(state.thread_id) || now >= state.expires_at {
+            self.prompt_loop = None;
+            self.add_info_message("Loop ended.".to_string(), /*hint*/ None);
+            return;
+        }
+        let Some(due_at) = state.due_at else {
+            self.frame_requester
+                .schedule_frame_in(state.expires_at - now);
+            return;
+        };
+        if now < due_at {
+            self.frame_requester
+                .schedule_frame_in(due_at.min(state.expires_at) - now);
+            return;
+        }
+        if self.pending_stream_consolidations > 0
+            || self.is_user_turn_pending_or_running()
+            || self.bottom_pane.is_task_running()
+            || !self.composer_is_empty()
+            || !self.bottom_pane.no_modal_or_popup_active()
+            || self.input_queue.has_queued_follow_up_messages()
+            || self.input_queue.suppress_queue_autosend
+            || self.input_queue.rate_limit_recovery_pending
+            || self.active_side_conversation
+            || self.has_misalignment_policy_violation()
+        {
+            // One retry timer, regardless of how many intervals elapsed while busy.
+            self.frame_requester
+                .schedule_frame_in(Duration::from_secs(/*secs*/ 1));
+            return;
+        }
+        let prompt = match state.cadence {
+            Cadence::Fixed(_) if !self.loop_tool_available => state.prompt.clone(),
+            cadence => format!(
+                "{} /loop (loopId: {}). Run the prompt below in this same conversation. {} Set quiet=true only when nothing meaningful changed; report meaningful changes normally. End this turn after the control call.\n\n{}",
+                if matches!(cadence, Cadence::SelfPaced) {
+                    "Self-paced"
+                } else {
+                    "Fixed"
+                },
+                state.id,
+                if matches!(cadence, Cadence::SelfPaced) {
+                    "Before ending, call schedule_loop to schedule the next check in 60–3600 seconds with a brief reason, or stop when complete."
+                } else {
+                    "Before ending, call schedule_loop action report with a brief reason, or stop when complete; report preserves fixed cadence."
+                },
+                state.prompt
+            ),
+        };
+        let next_due = match state.cadence {
+            Cadence::Fixed(interval) => Some(now + interval),
+            Cadence::SelfPaced => None,
+        };
+        let history_prompt = if state.showed_prompt {
+            String::new()
+        } else {
+            state.prompt.clone()
+        };
+        let thread_id = state.thread_id;
+        let expected_users = usize::from(!state.showed_prompt);
+        let repeated_prompt = state.showed_prompt.then(|| state.prompt.clone());
+        // A prior turn's active tool cell must precede this run's transcript boundary.
+        self.flush_active_cell();
+        let run_id = uuid::Uuid::new_v4().to_string();
+        self.quiet_loop_run = Some(super::quiet_loop::QuietLoopRun {
+            id: run_id.clone(),
+            thread_id,
+            turn_id: None,
+            client_id: None,
+            prompt: prompt.clone(),
+            summary: None,
+            completed: false,
+            valid: true,
+        });
+        self.app_event_tx.send(AppEvent::BeginQuietLoop {
+            thread_id,
+            run_id,
+            expected_users,
+        });
+        let (accepted, _) = self.submit_user_message_with_history_and_shell_escape_policy(
+            prompt.into(),
+            UserMessageHistoryRecord::Override(super::user_messages::UserMessageHistoryOverride {
+                text: history_prompt,
+                text_elements: Vec::new(),
+            }),
+            ShellEscapePolicy::Disallow,
+            UserMessageSource::Prompt,
+        );
+        if accepted && let Some(state) = &mut self.prompt_loop {
+            state.due_at = next_due;
+            state.showed_prompt = true;
+        }
+        if accepted && let Some(prompt) = repeated_prompt {
+            self.add_to_history(history_cell::QuietLoopPromptCell(
+                history_cell::new_user_prompt(prompt, Vec::new(), Vec::new(), Vec::new()),
+            ));
+        }
+        if !accepted {
+            self.quiet_loop_run = None;
+        }
+        if let Some(state) = &self.prompt_loop {
+            self.frame_requester.schedule_frame_in(
+                state
+                    .due_at
+                    .unwrap_or(state.expires_at)
+                    .saturating_duration_since(now),
+            );
+        }
+    }
+}
