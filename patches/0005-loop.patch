     Function(DynamicToolFunctionSpec),
 }
 
+/// Merge client-scoped tool additions without replacing existing tools.
+///
+/// Identical registrations are idempotent. A name already owned by a different
+/// function or namespace is rejected, and callers must publish only the complete
+/// successful result. Each request is limited to 8 KiB; the resulting registry
+/// is limited to 64 callable tools and 64 KiB of serialized specifications.
+pub fn merge_additional_dynamic_tools(
+    existing: &[DynamicToolSpec],
+    additions: &[DynamicToolSpec],
+) -> Result<Vec<DynamicToolSpec>, String> {
+    if serde_json::to_vec(additions)
+        .map_err(|error| error.to_string())?
+        .len()
+        > 8 * 1024
+    {
+        return Err("dynamic tool additions exceed 8 KiB".to_string());
+    }
+    let name = |tool: &DynamicToolSpec| match tool {
+        DynamicToolSpec::Function(function) => function.name.clone(),
+        DynamicToolSpec::Namespace(namespace) => namespace.name.clone(),
+    };
+    let mut merged = existing.to_vec();
+    for addition in additions {
+        if let Some(previous) = merged.iter().find(|tool| name(tool) == name(addition)) {
+            if previous != addition {
+                return Err(format!(
+                    "dynamic tool name already registered: {}",
+                    name(addition)
+                ));
+            }
+        } else {
+            merged.push(addition.clone());
+        }
+    }
+    let callable_count: usize = merged
+        .iter()
+        .map(|tool| match tool {
+            DynamicToolSpec::Function(_) => 1,
+            DynamicToolSpec::Namespace(namespace) => namespace.tools.len(),
+        })
+        .sum();
+    if merged.len() > 64
+        || callable_count > 64
+        || serde_json::to_vec(&merged)
+            .map_err(|error| error.to_string())?
+            .len()
+            > 64 * 1024
+    {
+        return Err("dynamic tool registry exceeds 64 tools or 64 KiB".to_string());
+    }
+    Ok(merged)
+}
