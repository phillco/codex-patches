+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn embedded_prompt_loop_tool_schedules_and_stops_without_task_mcp() -> Result<()> {
+    Box::pin(async {
+        let (mut app, mut rx, mut op_rx) = make_test_app_with_channels().await;
+        let mut server = crate::start_embedded_app_server_for_picker(app.chat_widget.config_ref()).await?;
+        // Use a persisted conversation: new empty threads have no rollout to resume yet.
+        let old_thread_id = legacy_loop_rollout(app.chat_widget.config_ref(), Vec::new())?;
+        let config = app.chat_widget.config_ref().clone();
+        let local_settings = crate::local_settings::LocalSettings::from(&config);
+        let started = server.resume_thread(&local_settings, config, old_thread_id, crate::app_server_session::ResumeModelSettings::PreserveExistingThread).await?;
+        assert!(started.loop_tool_available);
+        assert_eq!(started.session.thread_id, old_thread_id);
+        assert!(server.loop_tools_available(old_thread_id));
+        let thread_id = started.session.thread_id;
+        app.chat_widget.loop_tool_available = started.loop_tool_available;
+        app.enqueue_primary_thread_session(started.session, started.turns).await?;
+        app.chat_widget.insert_str("/loop check CI");
+        app.chat_widget.handle_key_event(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+        app.chat_widget.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+        app.chat_widget.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+        app.chat_widget.tick_prompt_loop(Instant::now());
+        let text = loop {
+            if let Op::UserTurn { items, .. } = op_rx.try_recv()? {
+                let codex_app_server_protocol::UserInput::Text { text, .. } = &items[0] else { panic!("expected prompt"); };
+                break text.clone();
+            }
+        };
+        let loop_id = text.split("loopId: ").nth(/*n*/ 1).unwrap().split(')').next().unwrap().to_string();
+        for (request_number, arguments, expected_success) in [
+            (1, serde_json::json!({"action":"schedule", "loopId":"stale", "delaySeconds":120, "reason":"CI"}), false),
+            (2, serde_json::json!({"action":"schedule", "loopId":loop_id, "delaySeconds":120, "reason":"CI"}), true),
+            (3, serde_json::json!({"action":"stop", "loopId":loop_id}), true),
+            (4, serde_json::json!({"action":"stop", "loopId":loop_id}), false),
+        ] {
+            while rx.try_recv().is_ok() {}
+            app.handle_app_server_event(&server, AppServerEvent::ServerRequest(Box::new(ServerRequest::DynamicToolCall {
+                request_id: AppServerRequestId::Integer(request_number),
+                params: codex_app_server_protocol::DynamicToolCallParams {
+                    thread_id: thread_id.to_string(), turn_id: "turn-loop".to_string(), call_id: format!("loop-{request_number}"),
+                    namespace: None, tool: crate::prompt_loop_tool::TOOL_NAME.to_string(), arguments,
+                },
+            }))).await;
+            let response = loop {
+                if let AppEvent::DynamicToolCallCompleted { response, .. } = rx.try_recv()? { break response; }
+            };
+            assert_eq!(response.success, expected_success);
+        }
+        Ok(())
+    }).await
+}
+
+#[tokio::test]
+async fn capped_legacy_tools_do_not_prevent_tui_resume_or_fork() -> Result<()> {
+    Box::pin(async {
+        let app = make_test_app().await;
+        let mut server = crate::start_embedded_app_server_for_picker(app.chat_widget.config_ref()).await?;
+        let tools = (0..64).map(|index| codex_app_server_protocol::DynamicToolSpec::Function(
+            codex_app_server_protocol::DynamicToolFunctionSpec {
+                name: format!("legacy_tool_{index}"), description: "Legacy client tool".to_string(),
+                input_schema: serde_json::json!({"type":"object","properties":{},"additionalProperties":false}),
+                defer_loading: false,
+            },
+        )).collect();
+        let thread_id = legacy_loop_rollout(app.chat_widget.config_ref(), tools)?;
+        let config = app.chat_widget.config_ref().clone();
+        let local_settings = crate::local_settings::LocalSettings::from(&config);
+        // A previous connection's remembered capability must not survive a rejected registration.
+        server.remember_loop_tool_thread(thread_id);
+        let resumed = server.resume_thread(&local_settings, config.clone(), thread_id, crate::app_server_session::ResumeModelSettings::PreserveExistingThread).await?;
+        assert_eq!(resumed.session.thread_id, thread_id);
+        assert!(!resumed.loop_tool_available);
+        assert!(!server.loop_tools_available(thread_id));
+        let fork = server.fork_thread(&local_settings, config, thread_id).await?;
+        assert_ne!(fork.session.thread_id, thread_id);
+        assert!(!fork.loop_tool_available);
+        assert!(!server.loop_tools_available(fork.session.thread_id));
+        Ok(())
+    }).await
+}
+
+fn legacy_loop_rollout(
+    config: &Config,
+    tools: Vec<codex_app_server_protocol::DynamicToolSpec>,
+) -> Result<ThreadId> {
+    let timestamp = "2026-11-01T00-00-00";
+    let id = app_test_support::create_fake_rollout(
+        config.codex_home.as_path(),
+        timestamp,
+        "2026-11-01T00:00:00Z",
+        "Original conversation context",
+        /*model_provider*/ None,
+        /*git_info*/ None,
+    )
+    .map_err(|error| color_eyre::eyre::eyre!(error.to_string()))?;
+    let path = app_test_support::rollout_path(config.codex_home.as_path(), timestamp, &id);
+    let mut lines = std::fs::read_to_string(&path)?
+        .lines()
+        .map(serde_json::from_str::<serde_json::Value>)
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    lines[0]["payload"]["dynamic_tools"] = serde_json::to_value(tools)?;
+    lines[0]["payload"]["cwd"] = serde_json::to_value(&config.cwd)?;
+    let contents = lines
+        .iter()
+        .map(serde_json::to_string)
+        .collect::<std::result::Result<Vec<_>, _>>()?
+        .join("\n")
+        + "\n";
+    std::fs::write(path, contents)?;
+    Ok(ThreadId::from_string(&id)?)
+}
