index 0000000000..b74c217826
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/quiet_loop.rs
@@ -0,0 +1,84 @@
+//! Identity and completion barriers for presentation-only automatic-turn collapse.
+use super::*;
+
+pub(super) struct QuietLoopRun {
+    pub(super) id: String,
+    pub(super) thread_id: ThreadId,
+    pub(super) turn_id: Option<String>,
+    pub(super) client_id: Option<String>,
+    pub(super) prompt: String,
+    pub(super) summary: Option<String>,
+    pub(super) completed: bool,
+    pub(super) valid: bool,
+}
+
+impl ChatWidget {
+    pub(super) fn note_loop_submission(&mut self, client_id: &str) {
+        if let Some(run) = &mut self.quiet_loop_run
+            && run.client_id.is_none()
+        {
+            run.client_id = Some(client_id.to_string());
+        } else {
+            self.invalidate_quiet_loop();
+        }
+    }
+    pub(super) fn loop_turn_started(&mut self, turn_id: &str) {
+        if let Some(run) = &mut self.quiet_loop_run {
+            if run.turn_id.is_none() {
+                run.turn_id = Some(turn_id.to_string());
+            } else if run.turn_id.as_deref() != Some(turn_id) {
+                self.quiet_loop_run = None;
+            }
+        }
+    }
+    pub(super) fn is_loop_echo(&self, client_id: Option<&str>, turn_id: &str, text: &str) -> bool {
+        self.quiet_loop_run.as_ref().is_some_and(|run| {
+            self.thread_id == Some(run.thread_id)
+                && run.turn_id.as_deref() == Some(turn_id)
+                && match client_id {
+                    Some(id) => run.client_id.as_deref() == Some(id),
+                    None => run.prompt == text,
+                }
+        })
+    }
+    pub(super) fn invalidate_quiet_loop(&mut self) {
+        if let Some(run) = &mut self.quiet_loop_run {
+            run.valid = false;
+            run.summary = None;
+        }
+    }
+    pub(super) fn record_quiet_loop_report(&mut self, turn_id: &str, summary: String, quiet: bool) {
+        if let Some(run) = &mut self.quiet_loop_run {
+            run.summary =
+                (quiet && run.valid && run.turn_id.as_deref() == Some(turn_id)).then_some(summary);
+        }
+    }
+    pub(super) fn complete_quiet_loop(&mut self, turn_id: &str, completed: bool) {
+        if self.quiet_loop_run.is_some() {
+            self.flush_active_cell();
+        }
+        if let Some(run) = &mut self.quiet_loop_run {
+            if run.turn_id.as_deref() != Some(turn_id) || !completed || !run.valid {
+                run.summary = None;
+            }
+            run.completed = true;
+        }
+        self.finish_quiet_loop_if_ready();
+    }
+    pub(super) fn finish_quiet_loop_if_ready(&mut self) {
+        if self.pending_stream_consolidations > 0
+            || !self
+                .quiet_loop_run
+                .as_ref()
+                .is_some_and(|run| run.completed)
+        {
+            return;
+        }
+        let run = self.quiet_loop_run.take().expect("completed run");
+        self.app_event_tx.send(AppEvent::FinishQuietLoop {
+            thread_id: run.thread_id,
+            run_id: run.id,
+            summary: if run.valid { run.summary } else { None },
+        });
+    }
+}
