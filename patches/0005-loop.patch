+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn quiet_loop_collapse_rebuilds_only_matching_turn_and_preserves_expanded_transcript()
+-> Result<()> {
+    let (mut app, _events, _ops) = make_test_app_with_channels().await;
+    let thread_id = ThreadId::new();
+    app.enqueue_primary_thread_session(
+        test_thread_session(thread_id, test_path_buf("/tmp")),
+        Vec::new(),
+    )
+    .await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    for mode in ["quiet", "nonquiet", "wrong-run", "wrong-thread", "shifted"] {
+        app.transcript_cells = vec![plain_line_cell("Previous conversation")];
+        app.begin_quiet_loop(thread_id, "run".into(), /*expected_users*/ 0);
+        app.transcript_cells
+            .extend([plain_line_cell("Checked CI"), plain_line_cell("Unchanged")]);
+        if mode == "shifted" {
+            app.transcript_cells
+                .insert(0, plain_line_cell("Older page"));
+        }
+        app.finish_quiet_loop(
+            &mut tui,
+            if mode == "wrong-thread" {
+                ThreadId::new()
+            } else {
+                thread_id
+            },
+            if mode == "wrong-run" { "other" } else { "run" }.into(),
+            (mode != "nonquiet").then(|| "Next loop in 5m · unchanged".to_string()),
+        )?;
+        let expected = match mode {
+            "quiet" => 2,
+            "nonquiet" => 3,
+            "shifted" => 5,
+            _ => 4,
+        };
+        assert_eq!(app.transcript_cells.len(), expected);
+        assert_eq!(
+            app.transcript_cells[usize::from(mode == "shifted")].raw_lines(),
+            vec![Line::from("Previous conversation")]
+        );
+        if mode == "quiet" {
+            assert_eq!(app.transcript_cells[1].display_lines(/*width*/ 80).len(), 1);
+            assert_eq!(
+                app.transcript_cells[1].transcript_lines(/*width*/ 80),
+                vec![Line::from("Checked CI"), Line::from("Unchanged")]
+            );
+            // Resize/reflow projection stays collapsed, with original children retained.
+            let rendered = app.render_transcript_lines_for_reflow(/*width*/ 30);
+            let visible = rendered
+                .lines
+                .iter()
+                .map(|line| line.line.to_string())
+                .collect::<Vec<_>>()
+                .join("\n");
+            assert!(visible.contains("Next loop in 5m"));
+            assert!(!visible.contains("Checked CI"));
+        }
+    }
+    Ok(())
+}
