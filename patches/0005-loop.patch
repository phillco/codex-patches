+    assert!(
+        chat.apply_prompt_loop_action(&thread_id.to_string(), "loop-turn", report)
+            .is_ok()
+    );
+    chat.note_stream_consolidation_queued();
+    chat.complete_quiet_loop("loop-turn", /*completed*/ true);
+    while let Ok(event) = rx.try_recv() {
+        assert!(!matches!(event, AppEvent::FinishQuietLoop { .. }));
+    }
+    chat.note_stream_consolidation_completed();
+    let summary = std::iter::from_fn(|| rx.try_recv().ok())
+        .find_map(|event| match event {
