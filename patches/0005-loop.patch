+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn tool(name: &str) -> DynamicToolSpec {
+    DynamicToolSpec::Function(DynamicToolFunctionSpec {
+        name: name.into(),
+        description: "small".into(),
+        input_schema: json!({"type":"object"}),
+        defer_loading: false,
+    })
+}
+
+#[test]
+fn additions_preserve_tools_are_idempotent_and_reject_collisions() {
+    let existing = vec![tool("existing")];
+    let registered =
+        merge_additional_dynamic_tools(&existing, &[tool("new")]).expect("valid registration");
+    assert_eq!(registered, vec![tool("existing"), tool("new")]);
+    assert_eq!(
+        merge_additional_dynamic_tools(&registered, &[tool("new")]).expect("valid registration"),
+        registered
+    );
+    let mut collision = tool("existing");
+    let DynamicToolSpec::Function(function) = &mut collision else {
+        unreachable!()
+    };
+    function.description = "different".into();
+    assert!(merge_additional_dynamic_tools(&existing, &[tool("new"), collision]).is_err());
+    let namespace = DynamicToolSpec::Namespace(DynamicToolNamespaceSpec {
+        name: "existing".into(),
+        description: String::new(),
+        tools: vec![],
+    });
+    assert!(merge_additional_dynamic_tools(&existing, &[namespace]).is_err());
+    assert_eq!(existing, vec![tool("existing")]);
+}
+
+#[test]
+fn bounds_addition_bytes_and_accumulated_callable_count_and_bytes() {
+    let mut huge = tool("huge");
+    let DynamicToolSpec::Function(function) = &mut huge else {
+        unreachable!()
+    };
+    function.description = "x".repeat(/*n*/ 8192);
+    assert!(merge_additional_dynamic_tools(&[], &[huge]).is_err());
+    let existing: Vec<_> = (0..64).map(|n| tool(&format!("tool{n}"))).collect();
+    assert!(merge_additional_dynamic_tools(&existing, &[tool("overflow")]).is_err());
+    let oversized = vec![DynamicToolSpec::Namespace(DynamicToolNamespaceSpec {
+        name: "large".into(),
+        description: "x".repeat(/*n*/ 65536),
+        tools: vec![],
+    })];
+    assert!(merge_additional_dynamic_tools(&oversized, &[tool("new")]).is_err());
+}
