+//! Registration is optional: only an explicit server marker permits a plain attach retry.
+use super::JSONRPC_INVALID_PARAMS;
+use super::JSONRPC_INVALID_REQUEST;
+use codex_app_server_protocol::JSONRPCErrorError;
+
+pub(super) fn is_loop_registration_rejected(error: &JSONRPCErrorError) -> bool {
+    matches!(error.code, JSONRPC_INVALID_REQUEST | JSONRPC_INVALID_PARAMS)
+        && error
+            .data
+            .as_ref()
+            .and_then(|data| data.get("dynamicToolRegistrationRejected"))
+            == Some(&serde_json::Value::Bool(true))
+}
+
+#[cfg(test)]
+#[path = "loop_registration_tests.rs"]
+mod tests;
