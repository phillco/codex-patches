@@ -0,0 +1,306 @@
+//! Registration on a pre-feature conversation retains its model-visible history.
+use anyhow::Context;
+use anyhow::Result;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use app_test_support::create_mock_responses_server_repeating_assistant;
+use codex_app_server_protocol::DynamicToolFunctionSpec;
+use codex_app_server_protocol::DynamicToolSpec;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ThreadForkParams;
+use codex_app_server_protocol::ThreadForkResponse;
+use codex_app_server_protocol::ThreadHistoryMode;
+use codex_app_server_protocol::ThreadResumeParams;
+use codex_app_server_protocol::ThreadResumeResponse;
+use codex_app_server_protocol::ThreadStartParams;
+use codex_app_server_protocol::TurnStartParams;
+use codex_app_server_protocol::TurnStartResponse;
+use codex_app_server_protocol::UserInput;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::time::Duration;
+use tempfile::TempDir;
+use tokio::time::timeout;
+
+const DEADLINE: Duration = Duration::from_secs(/*secs*/ 60);
+
+fn tool(name: &str) -> DynamicToolSpec {
+    DynamicToolSpec::Function(DynamicToolFunctionSpec {
+        name: name.to_string(),
+        description: "Client scheduling tool".to_string(),
+        input_schema: json!({"type":"object","properties":{},"additionalProperties":false}),
+        defer_loading: false,
+    })
+}
+
+async fn complete_turn(server: &mut TestAppServer, thread_id: &str, text: &str) -> Result<()> {
+    let request = server
+        .send_turn_start_request(TurnStartParams {
+            thread_id: thread_id.to_string(),
+            input: vec![UserInput::Text {
+                text: text.to_string(),
+                text_elements: vec![],
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let _: TurnStartResponse = timeout(DEADLINE, server.read_response(request)).await??;
+    timeout(
+        DEADLINE,
+        server.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    Ok(())
+}
+
+enum ResumeKind {
+    Live,
+    Cold,
+}
+
+async fn resume_existing_conversation(kind: ResumeKind) -> Result<()> {
+    let model = create_mock_responses_server_repeating_assistant("Done").await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&model.uri()).write(home.path())?;
+    let mut server = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    // This conversation predates the loop tool; it already owns another client tool.
+    let started = server
+        .start_thread(ThreadStartParams {
+            history_mode: Some(ThreadHistoryMode::Legacy),
+            dynamic_tools: Some(vec![tool("existing_tool")]),
+            ..Default::default()
+        })
+        .await?;
+    let thread_id = started.thread.id;
+    complete_turn(
+        &mut server,
+        &thread_id,
+        "remember the original conversation marker",
+    )
+    .await?;
+    if matches!(kind, ResumeKind::Cold) {
+        timeout(DEADLINE, server.shutdown_gracefully()).await??;
+        server = TestAppServer::builder()
+            .with_codex_home(home.path())
+            .build_initialized()
+            .await?;
+    }
+    let params = ThreadResumeParams {
+        thread_id: thread_id.clone(),
+        dynamic_tools: Some(vec![tool("schedule_loop")]),
+        ..Default::default()
+    };
+    // Repeating resume is an idempotent attach, including after cold loading.
+    for _ in 0..2 {
+        let request = server.send_thread_resume_request(params.clone()).await?;
+        let response: ThreadResumeResponse =
+            timeout(DEADLINE, server.read_response(request)).await??;
+        assert_eq!(response.dynamic_tools_registered, Some(true));
+        assert_eq!(response.thread.id, thread_id);
+        assert!(!response.thread.turns.is_empty());
+    }
+    // A collision rejects the whole request, including an earlier fresh addition.
+    let mut collision = tool("existing_tool");
+    let DynamicToolSpec::Function(function) = &mut collision else {
+        unreachable!()
+    };
+    function.description = "conflicting definition".to_string();
+    for additions in [
+        vec![tool("must_not_register"), collision],
+        vec![DynamicToolSpec::Function(DynamicToolFunctionSpec {
+            input_schema: json!({"type":"null"}),
+            ..match tool("invalid_schema") {
+                DynamicToolSpec::Function(f) => f,
+                DynamicToolSpec::Namespace(_) => unreachable!(),
+            }
+        })],
+    ] {
+        let request = server
+            .send_thread_resume_request(ThreadResumeParams {
+                dynamic_tools: Some(additions),
+                ..params.clone()
+            })
+            .await?;
+        let error = timeout(
+            DEADLINE,
+            server.read_stream_until_error_message(RequestId::Integer(request)),
+        )
+        .await??;
+        assert_eq!(error.error.code, -32600);
+        assert_eq!(
+            error.error.data,
+            Some(json!({"dynamicToolRegistrationRejected": true}))
+        );
+    }
+    complete_turn(&mut server, &thread_id, "continue in the same conversation").await?;
+    let request = server
+        .send_thread_fork_request(ThreadForkParams {
+            thread_id: thread_id.clone(),
+            dynamic_tools: Some(vec![tool("fork_tool")]),
+            ..Default::default()
+        })
+        .await?;
+    let fork: ThreadForkResponse = timeout(DEADLINE, server.read_response(request)).await??;
+    assert_eq!(fork.dynamic_tools_registered, Some(true));
+    assert_ne!(fork.thread.id, thread_id);
+    complete_turn(&mut server, &fork.thread.id, "continue the fork").await?;
+    let requests = model.received_requests().await.context("model requests")?;
+    let bodies = requests
+        .iter()
+        .filter(|request| request.url.path().ends_with("/responses"))
+        .map(wiremock::Request::body_json::<Value>)
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    assert_eq!(bodies.len(), 3);
+    let names = |body: &Value| {
+        body["tools"]
+            .as_array()
+            .expect("model request includes a tools array")
+            .iter()
+            .filter_map(|tool| tool["name"].as_str().map(str::to_string))
+            .collect::<Vec<_>>()
+    };
+    let resumed_names = names(&bodies[1]);
+    assert!(resumed_names.contains(&"existing_tool".to_string()));
+    assert_eq!(
+        resumed_names
+            .iter()
+            .filter(|name| *name == "schedule_loop")
+            .count(),
+        1
+    );
+    assert!(!resumed_names.contains(&"must_not_register".to_string()));
+    let fork_names = names(&bodies[2]);
+    assert!(fork_names.contains(&"existing_tool".to_string()));
+    assert!(fork_names.contains(&"fork_tool".to_string()));
+    for body in &bodies[1..] {
+        assert!(
+            body["input"]
+                .to_string()
+                .contains("original conversation marker")
+        );
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn live_resume_adds_tools_without_replacing_history_or_other_tools() -> Result<()> {
+    resume_existing_conversation(ResumeKind::Live).await
+}
+
+#[tokio::test]
+async fn cold_resume_adds_tools_without_replacing_history_or_other_tools() -> Result<()> {
+    resume_existing_conversation(ResumeKind::Cold).await
+}
+
+#[tokio::test]
+async fn legacy_registry_at_limit_remains_resumable_and_forkable_without_additions() -> Result<()> {
+    let model = create_mock_responses_server_repeating_assistant("Done").await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&model.uri()).write(home.path())?;
+    let mut server = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let legacy_tools = (0..64).map(|n| tool(&format!("legacy_tool_{n}"))).collect();
+    let started = server
+        .start_thread(ThreadStartParams {
+            history_mode: Some(ThreadHistoryMode::Legacy),
+            dynamic_tools: Some(legacy_tools),
+            ..Default::default()
+        })
+        .await?;
+    let thread_id = started.thread.id;
+    complete_turn(&mut server, &thread_id, "legacy conversation marker").await?;
+    for cold in [false, true] {
+        if cold {
+            timeout(DEADLINE, server.shutdown_gracefully()).await??;
+            server = TestAppServer::builder()
+                .with_codex_home(home.path())
+                .build_initialized()
+                .await?;
+        }
+        let request = server
+            .send_thread_resume_request(ThreadResumeParams {
+                thread_id: thread_id.clone(),
+                dynamic_tools: Some(vec![tool("schedule_loop")]),
+                ..Default::default()
+            })
+            .await?;
+        let error = timeout(
+            DEADLINE,
+            server.read_stream_until_error_message(RequestId::Integer(request)),
+        )
+        .await??;
+        assert_eq!(
+            error.error.data,
+            Some(json!({"dynamicToolRegistrationRejected": true}))
+        );
+        let request = server
+            .send_thread_resume_request(ThreadResumeParams {
+                thread_id: thread_id.clone(),
+                ..Default::default()
+            })
+            .await?;
+        let resumed: ThreadResumeResponse =
+            timeout(DEADLINE, server.read_response(request)).await??;
+        assert_eq!(resumed.thread.id, thread_id);
+        assert_eq!(resumed.dynamic_tools_registered, None);
+        assert!(!resumed.thread.turns.is_empty());
+        complete_turn(&mut server, &thread_id, "continue legacy conversation").await?;
+    }
+    let request = server
+        .send_thread_fork_request(ThreadForkParams {
+            thread_id: thread_id.clone(),
+            dynamic_tools: Some(vec![tool("schedule_loop")]),
+            ..Default::default()
+        })
+        .await?;
+    let error = timeout(
+        DEADLINE,
+        server.read_stream_until_error_message(RequestId::Integer(request)),
+    )
+    .await??;
+    assert_eq!(
+        error.error.data,
+        Some(json!({"dynamicToolRegistrationRejected": true}))
+    );
+    let request = server
+        .send_thread_fork_request(ThreadForkParams {
+            thread_id,
+            ..Default::default()
+        })
+        .await?;
+    let fork: ThreadForkResponse = timeout(DEADLINE, server.read_response(request)).await??;
+    assert_eq!(fork.dynamic_tools_registered, None);
+    complete_turn(&mut server, &fork.thread.id, "continue legacy fork").await?;
+    let requests = model.received_requests().await.context("model requests")?;
+    let bodies = requests
+        .iter()
+        .filter(|request| request.url.path().ends_with("/responses"))
+        .map(wiremock::Request::body_json::<Value>)
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    assert_eq!(bodies.len(), 4);
+    for body in bodies {
+        let tools = body["tools"].as_array().context("tool registry")?;
+        assert_eq!(
+            tools
+                .iter()
+                .filter(|tool| tool["name"]
+                    .as_str()
+                    .is_some_and(|name| name.starts_with("legacy_tool_")))
+                .count(),
+            64
+        );
+        assert!(!tools.iter().any(|tool| tool["name"] == "schedule_loop"));
+        assert!(
+            body["input"]
+                .to_string()
+                .contains("legacy conversation marker")
+        );
+    }
+    Ok(())
+}
