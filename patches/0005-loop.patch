+//! Client tools registered on an existing runtime apply only to future turns.
+use super::session::Session;
+use codex_protocol::dynamic_tools::DynamicToolSpec;
+
+impl Session {
+    #[tracing::instrument(level = "trace", skip_all)]
+    pub(crate) async fn register_dynamic_tools(
+        &self,
+        additions: &[DynamicToolSpec],
+    ) -> Result<(), String> {
+        let mut state = self.state.lock().await;
+        state.session_configuration.dynamic_tools =
+            codex_protocol::dynamic_tools::merge_additional_dynamic_tools(
+                &state.session_configuration.dynamic_tools,
+                additions,
+            )?;
+        Ok(())
+    }
+}
