@@ -0,0 +1,127 @@
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+SCRIPT = Path(__file__).with_name("heads_up.py")
+SPEC = importlib.util.spec_from_file_location("heads_up", SCRIPT)
+heads_up = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(heads_up)
+
+
+class HeadsUpTests(unittest.TestCase):
+    def test_grounded_warning(self):
+        self.assertEqual(
+            heads_up.warning_output(
+                {
+                    "warning": "Retries could double-charge customers.",
+                    "evidence": "Added retries",
+                },
+                "Added retries to payment calls.",
+            ),
+            {"systemMessage": "Heads Up · Retries could double-charge customers."},
+        )
+
+    def test_invalid_findings_are_rejected(self):
+        for result in (
+            {"warning": "Risk", "evidence": "invented quote"},
+            {"warning": "Risk", "evidence": None},
+            {"warning": "\x1b[31mRisk", "evidence": "source"},
+            {"warning": "x" * 361, "evidence": "source"},
+            {"warning": "Risk", "evidence": "source", "decision": "block"},
+            [],
+        ):
+            with self.subTest(result=result), self.assertRaises(ValueError):
+                heads_up.warning_output(result, "source")
+
+    def run_hook(self, payload, executable):
+        environment = os.environ.copy()
+        environment.pop("HEADS_UP_REVIEWING", None)
+        environment["HEADS_UP_CODEX"] = str(executable)
+        completed = subprocess.run(
+            [sys.executable, str(SCRIPT)],
+            input=json.dumps(payload),
+            text=True,
+            capture_output=True,
+            env=environment,
+            check=True,
+        )
+        return json.loads(completed.stdout)
+
+    def test_hook_runs_isolated_reviewer_and_displays_warning(self):
+        with tempfile.TemporaryDirectory() as directory:
+            fake = Path(directory) / "codex"
+            fake.write_text(
+                f"#!{sys.executable}\n"
+                "import json, os, pathlib, sys\n"
+                "args = sys.argv[1:]\n"
+                "assert '--ephemeral' in args and '--ignore-user-config' in args\n"
+                "assert args[args.index('--sandbox') + 1] == 'read-only'\n"
+                "assert 'features.hooks=false' in args and 'features.plugins=false' in args\n"
+                "assert 'features.shell_tool=false' in args\n"
+                "assert 'project_doc_max_bytes=0' in args\n"
+                "assert any(arg.startswith('model_instructions_file=') for arg in args)\n"
+                "assert os.environ['HEADS_UP_REVIEWING'] == '1'\n"
+                "assert pathlib.Path.cwd().name.startswith('codex-heads-up-')\n"
+                "assert 'Added retries' in sys.stdin.read()\n"
+                "pathlib.Path(args[args.index('--output-last-message') + 1]).write_text(\n"
+                "json.dumps({'warning': 'Retries could double-charge customers.', 'evidence': 'Added retries'}))\n"
+            )
+            fake.chmod(0o755)
+            self.assertEqual(
+                self.run_hook(
+                    {
+                        "hook_event_name": "Stop",
+                        "last_assistant_message": "Added retries",
+                    },
+                    fake,
+                ),
+                {"systemMessage": "Heads Up · Retries could double-charge customers."},
+            )
+
+    def test_skips_recursive_subagent_empty_and_oversize_responses(self):
+        for payload in (
+            {
+                "hook_event_name": "Stop",
+                "stop_hook_active": True,
+                "last_assistant_message": "text",
+            },
+            {"hook_event_name": "SubagentStop", "last_assistant_message": "text"},
+            {"hook_event_name": "Stop", "last_assistant_message": ""},
+            {"hook_event_name": "Stop", "last_assistant_message": "x" * 12001},
+        ):
+            with self.subTest(payload=payload):
+                self.assertEqual(self.run_hook(payload, "/nonexistent-codex"), {})
+
+    def test_failure_does_not_block_turn(self):
+        self.assertEqual(
+            self.run_hook(
+                {"hook_event_name": "Stop", "last_assistant_message": "text"},
+                "/nonexistent-codex",
+            ),
+            {},
+        )
+
+    def test_clean_review_is_quiet(self):
+        self.assertEqual(
+            heads_up.warning_output({"warning": None, "evidence": None}, "text"), {}
+        )
+
+    def test_timeout_is_bounded(self):
+        with patch.object(
+            heads_up.subprocess,
+            "run",
+            side_effect=subprocess.TimeoutExpired("codex", 35),
+        ) as run:
+            with self.assertRaises(subprocess.TimeoutExpired):
+                heads_up.review("text", None, "codex")
+            self.assertEqual(run.call_args.kwargs["timeout"], 35)
+
+
+if __name__ == "__main__":
+    unittest.main()
